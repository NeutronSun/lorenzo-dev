{% doc %}
  Renders breadcrumb navigation as a text block.

  @example
  {% content_for 'block', type: 'breadcrumb', id: 'breadcrumb' %}
{% enddoc %}

{% capture breadcrumb_content %}
  {%- render 'breadcrumb-nav',
    linklist: block.settings.linklist,
    separator: block.settings.separator,
    home: block.settings.home,
    show_leaf: block.settings.show_leaf
  -%}
{% endcapture %}

{% content_for 'block', type: 'text', id: 'text', body: breadcrumb_content %}

{% schema %}
{
  "name": "t:general.breadcrumbs",
  "blocks": [{ "type": "text" }],
  "settings": [
    {
      "type": "link_list",
      "id": "linklist",
      "label": "t:labels.breadcrumbs_linklist",
    },
    {
      "type": "text",
      "id": "separator",
      "label": "t:labels.breadcrumbs_separator",
      "default": "/"
    },
    {
      "type": "text",
      "id": "home",
      "label": "t:labels.breadcrumbs_home",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_leaf",
      "label": "t:labels.breadcrumbs_show_leaf",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.breadcrumbs",
      "category": "Navigation",
      "blocks": [
        {
          "type": "text",
          "id": "text",
          "static": true,
          "settings": {
            "font": "mono",
            "color": "secondary",
            "font_size": 10,
            "text_transform": "uppercase",
            "alignment": "left"
          }
        }
      ]
    }
  ]
}
{% endschema %}
