{% doc %}
  Renders PDP fusion bundle panel.

  @param {product} product - Product object
{% enddoc %}

{% liquid
  assign picker_product = product | default: closest.product
  assign current_variant = picker_product.selected_or_first_available_variant
  assign bundle_data = picker_product.metafields.montura.bundle_data.value
  assign bundle_products = bundle_data.products.value
  assign bundle_name = bundle_data.name.value | default: bundle_data.name
  assign bundle_key = bundle_data.system.id | default: bundle_data.system.handle | default: bundle_name
  assign bundle_display_product = bundle_data.bundle.value
  assign bundle_parent_product = picker_product.metafields.bundle.bundle.value | default: bundle_data.bundle.value
  assign bundle_parent_variant = bundle_parent_product.first_available_variant
  assign bundle_id = bundle_parent_variant.id | append: '||' | append: bundle_key
  assign bundle_discount = bundle_data.discount_percentage.value | default: bundle_data.discount_percentage | default: 0 | plus: 0
  assign bundle_total = 0
  assign bundle_available = true
  assign bundle_items_count = 0

  unless bundle_parent_variant
    assign bundle_available = false
    assign bundle_id = blank
  endunless

  if bundle_discount < 0
    assign bundle_discount = 0
  endif

  if bundle_discount > 100
    assign bundle_discount = 100
  endif

  for bundle_product in bundle_products
    if bundle_product.id == picker_product.id
      assign bundle_variant = current_variant
    else
      assign bundle_variant = bundle_product.first_available_variant
    endif

    assign bundle_items_count = bundle_items_count | plus: 1
    assign bundle_product_price = bundle_variant.price | default: bundle_product.price
    assign bundle_total = bundle_total | plus: bundle_product_price

    unless bundle_variant.available
      assign bundle_available = false
    endunless
  endfor

  assign bundle_multiplier = 100 | minus: bundle_discount
  assign bundle_discounted_total = bundle_total | times: bundle_multiplier | divided_by: 100
%}

{% if bundle_data != blank and bundle_products != blank %}
  <section class="pdp-bundle panel bundle-panel" {{ block.shopify_attributes }}>
    <h2 class="bundle-title font-mono">
      <span>{{ bundle_display_product.title | default: 'Fusion bundle' }}</span>

      {% if bundle_discount > 0 %}
        <span class="bundle-discount">-{{ bundle_discount }}%</span>
      {% endif %}
    </h2>

    <pdp-bundle class="bundle">
      <script type="application/json" ref="bundleData">
        {
          "bundleId": {{ bundle_id | json }},
          "items": [
            {% for bundle_product in bundle_products %}
              {% liquid
                if bundle_product.id == picker_product.id
                  assign bundle_variant = current_variant
                else
                  assign bundle_variant = bundle_product.first_available_variant
                endif
              %}
              {% unless forloop.first %},{% endunless %}
              {
                "id": {% if bundle_variant %}{{ bundle_variant.id | json }}{% else %}null{% endif %},
                "available": {{ bundle_variant.available | default: false | json }}
              }
            {% endfor %}
          ]
        }
      </script>

      <div class="bundle-products">
        {% for bundle_product in bundle_products %}
          {% liquid
            if bundle_product.id == picker_product.id
              assign bundle_variant = current_variant
            else
              assign bundle_variant = bundle_product.first_available_variant
            endif

            assign bundle_product_price = bundle_variant.price | default: bundle_product.price
            assign bundle_variant_title = bundle_variant.title | default: 'Sold out'

            if bundle_variant_title == 'Default Title'
              assign bundle_variant_title = 'Included'
            endif
          %}

          <a class="bundle-product" href="{{ bundle_product.url }}" aria-label="{{ bundle_product.title | escape }}">
            <span class="bundle-product-image">
              {% if bundle_product.featured_image %}
                <img
                  src="{{ bundle_product.featured_image | image_url: width: 128 }}"
                  alt="{{ bundle_product.featured_image.alt | default: bundle_product.title | escape }}"
                  width="56"
                  height="56"
                  loading="lazy"
                >
              {% endif %}
            </span>

            <span class="bundle-product-info">
              <span class="bundle-product-title">{{ bundle_product.title }}</span>
              <span class="bundle-product-variant font-mono">{{ bundle_variant_title }}</span>
            </span>

            <span class="bundle-product-price">{{ bundle_product_price | money }}</span>
          </a>
        {% endfor %}
      </div>

      <div class="bundle-total font-mono">
        <span>{{ bundle_items_count }} pieces</span>
        <span class="bundle-prices">
          {% if bundle_discount > 0 %}
            <s>{{ bundle_total | money }}</s>
          {% endif %}

          <strong>{{ bundle_discounted_total | money }}</strong>
        </span>
      </div>

      <button type="button" class="add bundle-add font-mono" ref="add" on:click="addToCart" {% unless bundle_available %}disabled{% endunless %}>
        {% render 'icon-bag', size: 16 %}
        <span>{% if bundle_available %}Add bundle{% else %}Bundle sold out{% endif %}</span>
        <span>{{ bundle_discounted_total | money }} -></span>
      </button>
    </pdp-bundle>
  </section>
{% endif %}

{% stylesheet %}
  .pdp-bundle.panel.bundle-panel {
    display: grid;
  }

  .pdp-bundle > h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    color: var(--black);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .pdp-bundle .bundle-title > span {
    min-width: 0;
  }

  .pdp-bundle .bundle-title .bundle-discount {
    flex: 0 0 auto;
    color: var(--green);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-align: right;
  }

  .pdp-bundle .bundle {
    display: grid;
    gap: 14px;
    padding: 16px 20px;
  }

  .pdp-bundle .bundle-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--secondary-black);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pdp-bundle .bundle-total span {
    min-width: 0;
  }

  .pdp-bundle .bundle-products {
    display: grid;
    gap: 8px;
  }

  .pdp-bundle .bundle-product {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    color: var(--black);
    text-decoration: none;
  }

  .pdp-bundle .bundle-product-image {
    display: block;
    width: 56px;
    height: 56px;
    border: 1px solid var(--border-color);
    background: var(--background-darken);
    overflow: hidden;
  }

  .pdp-bundle .bundle-product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-bundle .bundle-product-info {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .pdp-bundle .bundle-product-title,
  .pdp-bundle .bundle-product-variant {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pdp-bundle .bundle-product-title {
    font-size: 13px;
    line-height: 1.2;
  }

  .pdp-bundle .bundle-product-variant {
    color: var(--secondary-black);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pdp-bundle .bundle-product-price {
    font-size: 13px;
    white-space: nowrap;
  }

  .pdp-bundle .bundle-prices {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    white-space: nowrap;
  }

  .pdp-bundle .bundle-prices s {
    color: var(--secondary-black);
    font-weight: 400;
  }

  .pdp-bundle .bundle-prices strong {
    color: var(--black);
    font-weight: 400;
  }

  .pdp-bundle .add {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid var(--black);
    background: var(--black);
    color: var(--white);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .pdp-bundle .add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pdp-bundle .add svg {
    flex: 0 0 auto;
  }

  .pdp-bundle .bundle-add {
    margin-top: 2px;
  }

  .pdp-bundle .bundle[pending] .bundle-add {
    opacity: 0.65;
    cursor: wait;
  }

  @media screen and (max-width: 749px) {
    .pdp-bundle .bundle {
      padding-inline: 16px;
    }

    .pdp-bundle .bundle-product {
      grid-template-columns: 48px minmax(0, 1fr);
    }

    .pdp-bundle .bundle-product-image {
      width: 48px;
      height: 48px;
    }

    .pdp-bundle .bundle-product-price {
      grid-column: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Bundle",
      "category": "Product"
    }
  ]
}
{% endschema %}
