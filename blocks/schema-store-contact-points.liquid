    {
      "name": "Contact points",
      "blocks": [
        {
          "type": "schema-contact-point",
          "settings": {
            "contact_type": "customer support",
            "telephone": "+39 329 823 6955",
            "languages": "Italian, English"
          }
        },
        {
          "type": "schema-contact-point",
          "settings": {
            "contact_type": "sales",
            "telephone": "+39 329 823 6955"
          }
        }
      ]
    }
  ]
}
{% endschema %}
