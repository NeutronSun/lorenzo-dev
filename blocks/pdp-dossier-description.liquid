{% doc %}
  Renders PDP dossier description.
{% enddoc %}

{% liquid
  assign text = block.settings.text | default: 'Lightweight technical longsleeve engineered for layering. Brushed inner face, 4-way stretch, flat-lock seams.'
  assign mobile_order = block.settings.mobile_order | default: 2
%}

{% capture panel_body %}
  <div class="pdp-dossier-body">
    <div class="content">{{ text }}</div>
  </div>
{% endcapture %}

{% render 'pdp-dossier-panel',
  title: '/Notes',
  panel_class: 'pdp-dossier-description',
  panel_id: block.id,
  mobile_order: mobile_order,
  open_by_default: block.settings.open_by_default,
  body: panel_body,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Notes",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Lightweight technical longsleeve engineered for layering. Brushed inner face, 4-way stretch, flat-lock seams.</p>"
    },
    {
      "type": "number",
      "id": "mobile_order",
      "label": "Mobile order",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Notes",
      "category": "Product"
    }
  ]
}
{% endschema %}
