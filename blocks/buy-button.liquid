{% doc %}
  Renders buy button and shipping note.

  @param {product} product - Product object
  @param {variant} [variant] - Resolved in sections/product.liquid
{% enddoc %}

{% liquid
  assign picker_product = product | default: closest.product
  assign current_variant = variant | default: closest.variant

  if picker_product.has_only_default_variant
    assign current_variant = picker_product.selected_variant

    if current_variant.available
      assign button_state = 'add'
    else
      assign button_state = 'sold-out'
    endif
  elsif current_variant == blank
    assign button_state = 'select-size'
  elsif current_variant.available
    assign button_state = 'add'
  else
    assign button_state = 'sold-out'
  endif
%}

<div class="buy-button-block" ref="buyButton" {{ block.shopify_attributes }}>
  <product-form on:submit="onSubmit">
    {% form 'product', picker_product %}
      <input
        type="hidden"
        name="id"
        {% if button_state == 'add' and current_variant != blank %}
          value="{{ current_variant.id }}"
        {% else %}
          disabled
        {% endif %}>

      <input type="hidden" name="quantity" value="1">

      <button
        type="submit"
        class="add font-mono"
        data-button-state="{{ button_state }}"
        {% unless button_state == 'add' %}disabled{% endunless %}>

        {% render 'icon-bag', size: 16 %}

        <span class="label" data-label="select-size">Select size</span>
        <span class="label" data-label="sold-out">Sold out</span>
        <span class="label" data-label="add">Add to bag</span>
      </button>
    {% endform %}
  </product-form>

  <p class="shipping font-mono">Free EU shipping &middot; 30-day returns</p>
</div>

{% stylesheet %}
  .buy-button-block product-form {
    display: block;
    padding: 16px 20px 8px;
  }

  .buy-button-block .add {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid var(--black);
    background: var(--black);
    color: var(--white);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .buy-button-block .add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .buy-button-block .add svg {
    flex: 0 0 auto;
  }

  .buy-button-block .add .label {
    display: none;
  }

  .buy-button-block .add[data-button-state="select-size"] .label[data-label="select-size"],
  .buy-button-block .add[data-button-state="sold-out"] .label[data-label="sold-out"],
  .buy-button-block .add[data-button-state="add"] .label[data-label="add"] {
    display: block;
  }

  .pdp-product-configurator:has(variant-picker:not([complete])) .buy-button-block .add[data-button-state="add"] .label[data-label="add"],
  .pdp-product-configurator:has(variant-picker:not([complete])) .buy-button-block .add[data-button-state="sold-out"] .label[data-label="sold-out"] {
    display: none;
  }

  .pdp-product-configurator:has(variant-picker:not([complete])) .buy-button-block .add .label[data-label="select-size"] {
    display: block;
  }

  .pdp-product-configurator:has(variant-picker:not([complete])) .buy-button-block .add {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .buy-button-block .shipping {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 0 20px 18px;
    color: var(--secondary-black);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .buy-button-block product-form,
    .buy-button-block .shipping {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Buy button",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Buy button",
      "category": "Product"
    }
  ]
}
{% endschema %}
