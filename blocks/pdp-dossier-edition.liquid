{% doc %}
  Renders PDP dossier edition details.
{% enddoc %}

{% liquid
  assign season = block.settings.season | default: 'SS/26 - DROP 04'
  assign number = block.settings.number | default: '04/24'
  assign series = block.settings.series | default: 'A'
  assign mobile_order = block.settings.mobile_order | default: 0
%}

{% capture panel_body %}
  <div class="pdp-dossier-body">
    <p class="season font-mono">{{ season }}</p>

    <dl class="values">
      <dt class="font-mono">N&deg;</dt>
      <dd>{{ number }}</dd>
      <dt class="font-mono">Series</dt>
      <dd>{{ series }}</dd>
    </dl>
  </div>
{% endcapture %}

{% render 'pdp-dossier-panel',
  title: '/Edition',
  panel_class: 'pdp-dossier-edition',
  panel_id: block.id,
  mobile_order: mobile_order,
  open_by_default: block.settings.open_by_default,
  body: panel_body,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "PDP Dossier Edition",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "season",
      "label": "Season",
      "default": "SS/26 - DROP 04"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "default": "04/24"
    },
    {
      "type": "text",
      "id": "series",
      "label": "Series",
      "default": "A"
    },
    {
      "type": "number",
      "id": "mobile_order",
      "label": "Mobile order",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "PDP Dossier Edition",
      "category": "Product"
    }
  ]
}
{% endschema %}
