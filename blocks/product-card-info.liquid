{% capture details %}
  {% content_for 'block', type: 'product-card-details', id: 'details', product: product %}
{% endcapture %}

{% capture swatches %}
  {% content_for 'block', type: 'product-card-swatches', id: 'swatches', product: product %}
{% endcapture %}

{% render 'product-card-info',
  product: product,
  match_prefix: 'Model_',
  siblings_limit: 10,
  details: details,
  swatches: swatches,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Info",
  "blocks": [
    { "type": "product-card-details" },
    { "type": "product-card-swatches" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Info",
      "category": "Product card"
    }
  ]
}
{% endschema %}
