{% capture media %}
  {% content_for 'block', type: 'product-card-media', id: 'media', product: product %}
{% endcapture %}

{% capture info %}
  {% content_for 'block', type: 'product-card-info', id: 'info', product: product %}
{% endcapture %}

{% render 'product-card',
  product: product,
  match_prefix: 'Model_',
  siblings_limit: 10,
  media: media,
  info: info,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Product Card",
  "blocks": [
    { "type": "product-card-media" },
    { "type": "product-card-info" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product Card",
      "category": "Product card"
    }
  ]
}
{% endschema %}
