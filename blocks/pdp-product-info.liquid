{% doc %}
  Renders PDP product info column.
{% enddoc %}

<div ref="info" class="pdp-product-info" style="view-transition-name: product-info;" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .pdp-product-info {
    display: grid;
    gap: 16px;

    .panel {
      background: var(--white);
      box-shadow: 0 10px 28px rgb(0 0 0 / 0.04);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Info",
  "tag": null,
  "blocks": [
    { "type": "pdp-heading" },
    { "type": "pdp-product-configurator" },
    { "type": "pdp-bundle" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Info",
      "category": "Product"
    }
  ]
}
{% endschema %}
