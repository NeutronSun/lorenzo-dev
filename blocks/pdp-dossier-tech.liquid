{% doc %}
  Renders PDP dossier technical rows.
{% enddoc %}

{% liquid
  assign mobile_order = block.settings.mobile_order | default: 3
%}

{% capture panel_body %}
  <dl class="rows">
    {% content_for 'blocks' %}
  </dl>
{% endcapture %}

{% render 'pdp-dossier-panel',
  title: '/Technical',
  panel_class: 'pdp-dossier-tech',
  panel_id: block.id,
  mobile_order: mobile_order,
  open_by_default: block.settings.open_by_default,
  body: panel_body,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Technical",
  "tag": null,
  "blocks": [
    { "type": "pdp-dossier-tech-row" }
  ],
  "settings": [
    {
      "type": "number",
      "id": "mobile_order",
      "label": "Mobile order",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Technical",
      "category": "Product"
    }
  ]
}
{% endschema %}
