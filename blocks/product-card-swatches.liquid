{% render 'product-card-swatches',
  product: product,
  match_prefix: block.settings.match_prefix,
  siblings_limit: block.settings.siblings_limit,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Swatches",
  "settings": [
    {
      "type": "select",
      "id": "match_prefix",
      "label": "Match tag prefix",
      "default": "Model_",
      "options": [
        { "value": "Model_", "label": "Model_" },
        { "value": "Tema_", "label": "Tema_" }
      ]
    },
    {
      "type": "range",
      "id": "siblings_limit",
      "label": "Siblings limit",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Swatches",
      "category": "Product card"
    }
  ]
}
{% endschema %}
