<product-card-swatches {{ block.shopify_attributes }}>
  <span style="--swatch-color: oklch(90% 0.04 85);"></span>
  <span style="--swatch-color: oklch(18% 0.02 260);"></span>
  <span style="--swatch-color: oklch(36% 0.05 130);"></span>
</product-card-swatches>

{% stylesheet %}
  product-card-swatches {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    min-height: 12px;
  }

  product-card-swatches span {
    width: 12px;
    height: 12px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--swatch-color);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swatches",
  "settings": [],
  "presets": [
    {
      "name": "Swatches",
      "category": "Product card"
    }
  ]
}
{% endschema %}
