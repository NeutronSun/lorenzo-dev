,
{
  "@type": "OpeningHoursSpecification",
  "dayOfWeek": {{ block.settings.day | json }},
  "opens": {{ block.settings.opens | json }},
  "closes": {{ block.settings.closes | json }}
  {%- if block.settings.valid_from != blank -%}
  ,
  "validFrom": {{ block.settings.valid_from | json }}
  {%- endif -%}
  {%- if block.settings.valid_through != blank -%}
  ,
  "validThrough": {{ block.settings.valid_through | json }}
  {%- endif -%}
}

{% schema %}
{
  "name": "Opening hours",
  "settings": [
    {
      "type": "select",
      "id": "day",
      "label": "Day",
      "options": [
        { "value": "Monday", "label": "Monday" },
        { "value": "Tuesday", "label": "Tuesday" },
        { "value": "Wednesday", "label": "Wednesday" },
        { "value": "Thursday", "label": "Thursday" },
        { "value": "Friday", "label": "Friday" },
        { "value": "Saturday", "label": "Saturday" },
        { "value": "Sunday", "label": "Sunday" }
      ]
    },
    { "type": "text", "id": "opens", "label": "Opens", "default": "09:00" },
    { "type": "text", "id": "closes", "label": "Closes", "default": "18:00" },
    {
      "type": "text",
      "id": "valid_from",
      "label": "Valid from",
      "info": "Optional. Format YYYY-MM-DD"
    },
    {
      "type": "text",
      "id": "valid_through",
      "label": "Valid through",
      "info": "Optional. Format YYYY-MM-DD"
    }
  ],
  "tag": null,
  "presets": [{ "name": "Opening hours" }]
}
{% endschema %}
