{% doc %}
  Renders variant picker block wrapper.

  @param {product} product - Product object
  @param {variant} [variant] - Resolved in parent section when available
{% enddoc %}

{% liquid
  assign picker_product = product | default: closest.product
  assign variant = variant | default: closest.variant
%}

<div class="variant-picker-block" {{ block.shopify_attributes }}>
  {% render 'variant-picker', product: picker_product, variant: variant %}
</div>

{% schema %}
{
  "name": "Variant picker",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Variant picker",
      "category": "Product"
    }
  ]
}
{% endschema %}
