{% doc %}
  Renders PDP product configurator panel.

  @param {product} product - Product object
{% enddoc %}

{% liquid
  assign picker_product = product | default: closest.product
%}

<section class="pdp-product-configurator panel config" {{ block.shopify_attributes }}>
  <h2 class="font-mono">/Configure</h2>

  {% content_for 'block', type: 'pdp-variant-picker', id: 'variant-picker', product: picker_product %}
  {% content_for 'block', type: 'pdp-siblings', id: 'siblings', product: picker_product %}
  {% content_for 'block', type: 'pdp-buy-button', id: 'buy-button', product: picker_product %}
</section>

{% stylesheet %}
  .pdp-product-configurator.panel.config {
    display: grid;
  }

  .pdp-product-configurator > h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    color: var(--black);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product configurator",
  "tag": null,
  "blocks": [
    { "type": "pdp-variant-picker" },
    { "type": "pdp-siblings" },
    { "type": "pdp-buy-button" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product configurator",
      "category": "Product"
    }
  ]
}
{% endschema %}
