{% capture labels %}
  {% content_for 'block', type: 'product-card-labels', id: 'labels', product: product %}
{% endcapture %}

{% render 'product-card-media',
  product: product,
  show_new_in: true,
  show_sold_out: true,
  show_rarity: true,
  labels: labels,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Media",
  "blocks": [
    { "type": "product-card-labels" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Media",
      "category": "Product card"
    }
  ]
}
{% endschema %}
