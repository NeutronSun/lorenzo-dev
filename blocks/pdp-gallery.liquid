{% doc %}
  Renders PDP gallery.

  @param {product} product - Product object
{% enddoc %}

{% liquid
  assign media_count = product.images.size
  assign first_image = product.featured_image | default: product.images.first
  assign current_variant = product.selected_or_first_available_variant
  assign macro_category = product.metafields.valeverce.macro_category.value | default: product.metafields.valeverce.macro_category
  assign micro_category = product.metafields.valeverce.micro_category.value | default: product.metafields.valeverce.micro_category
%}

<div ref="gallery" class="pdp-gallery{% unless media_count > 1 %} single{% endunless %}" {{ block.shopify_attributes }}>
  <div class="media" style="view-transition-name: product-image;">
    <div class="head font-mono">
      {% if product.available %}
        <span class="stock">
          <span></span>
          In stock
        </span>
      {% else %}
        <span class="stock sold-out">
          <span></span>
          Sold out
        </span>
      {% endif %}

      <span class="category">{{ macro_category | default: product.type }}</span>

      <span class="counter">01 / {{ media_count | at_least: 1 | prepend: '00' | slice: -2, 2 }}</span>
    </div>

    <div class="image">
      {% if first_image %}
        {{
          first_image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '420, 640, 820, 1100, 1400, 1600',
            alt: product.title
        }}
      {% endif %}

      <button type="button" class="save font-mono" aria-label="Save {{ product.title | escape }}">
        <span aria-hidden="true">&#9825;</span>
      </button>

      <div class="caption">
        <div class="caption-meta font-mono">
          <span>{{ current_variant.sku | default: product.handle }}</span>
          {% if micro_category != blank %}
            <span>{{ micro_category }}</span>
          {% endif %}
        </div>

        <div class="caption-row">
          <span>{{ product.title }}</span>
          <span>{{ current_variant.price | money }}</span>
        </div>
      </div>
    </div>
  </div>

  {% if media_count > 1 %}
    <div class="thumbs-container">
      <div class="thumbs" aria-label="Product media">
        {% for image in product.images limit: 4 %}
          <button
            type="button"
            class="thumb{% if forloop.first %} active{% endif %}"
            aria-label="View image {{ forloop.index }} of {{ media_count }}"
          >
            {{
              image
              | image_url: width: 360
              | image_tag:
                loading: 'lazy',
                widths: '120, 180, 240, 360',
                alt: product.title
            }}
          </button>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .pdp-gallery {
    display: block;
    min-width: 0;

    .media {
      position: relative;
      display: grid;
      grid-template-rows: 52px minmax(0, 1fr);
      min-height: 0;
      padding: 8px 16px 16px;
      border: 1px solid var(--border-color);
      background: var(--white);
      box-shadow: 0 10px 28px rgb(0 0 0 / 0.04);
      overflow: hidden;
    }

    .media::before,
    .media::after,
    .image::before,
    .image::after {
      content: "";
      position: absolute;
      z-index: 3;
      width: 14px;
      height: 14px;
      pointer-events: none;
    }

    .media::before {
      top: 8px;
      left: 8px;
      border-top: 1px solid var(--border-color);
      border-left: 1px solid var(--border-color);
    }

    .media::after {
      top: 8px;
      right: 8px;
      border-top: 1px solid var(--border-color);
      border-right: 1px solid var(--border-color);
    }

    .head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 16px;
      min-height: 52px;
      border-bottom: 1px solid var(--border-color);
      color: var(--secondary-black);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .stock,
    .counter,
    .category {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .stock {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      justify-self: start;
    }

    .stock span {
      flex: 0 0 auto;
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: var(--green);
    }

    .stock.sold-out span {
      background: var(--red);
    }

    .category {
      justify-self: center;
    }

    .counter {
      justify-self: end;
    }

    .image {
      position: relative;
      min-height: 0;
      background: var(--background-darken);
      overflow: hidden;
    }

    .image::before {
      bottom: 8px;
      left: 8px;
      border-bottom: 1px solid var(--border-color);
      border-left: 1px solid var(--border-color);
    }

    .image::after {
      right: 8px;
      bottom: 8px;
      border-right: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
    }

    img {
      display: block;
      width: 100%;
      height: 100%;
    }

    .image > img {
      object-fit: contain;
    }

    .save {
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 4;
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      padding: 0;
      border: 1px solid var(--border-color);
      background: rgb(255 255 255 / 0.82);
      color: var(--black);
      font-size: 16px;
      line-height: 1;
      cursor: pointer;
    }

    .caption {
      position: absolute;
      right: 20px;
      bottom: 20px;
      left: 20px;
      z-index: 4;
      display: grid;
      gap: 8px;
      min-height: 52px;
      padding: 10px 12px;
      background: rgb(24 23 21 / 0.42);
      color: var(--white);
    }

    .caption-meta,
    .caption-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-width: 0;
    }

    .caption-meta {
      font-size: 9px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .caption-row {
      font-size: 14px;
      line-height: 1.1;
    }

    .caption span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .thumbs-container {
      margin-block-start: var(--gallery-gap);
      padding: 8px;
      border: 1px solid var(--border-color);
      background: var(--white);
      box-shadow: 0 10px 28px rgb(0 0 0 / 0.04);
    }

    .thumbs {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gallery-gap);
      height: var(--thumb-size);
      min-height: 0;
    }

    .thumb {
      min-width: 0;
      padding: 0;
      border: 1px solid transparent;
      background: var(--background-darken);
      cursor: pointer;
      overflow: hidden;
    }

    .thumb img {
      object-fit: cover;
    }

    .thumb.active {
      border-color: var(--black);
    }
  }

  @media screen and (max-width: 749px) {
    .pdp-gallery {
      .media {
        min-height: 0;
      }

      .image > img {
        object-fit: cover;
      }

      .head {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      }

      .category {
        display: none;
      }

      .caption {
        right: 12px;
        bottom: 12px;
        left: 12px;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Gallery",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "PDP Gallery",
      "category": "Product"
    }
  ]
}
{% endschema %}
