{% doc %}
  Renders PDP siblings picker with block-configured tabs.

  @param {product} product - Product object
{% enddoc %}

{% liquid
  assign picker_product = product | default: closest.product
  assign pm_value = picker_product.metafields.valeverce.pm.value | default: picker_product.metafields.valeverce.pm
  assign micro_value = picker_product.metafields.elastick.filter_microcategory.value | default: picker_product.metafields.elastick.filter_microcategory | default: picker_product.metafields.valeverce.micro_category.value | default: picker_product.metafields.valeverce.micro_category
  assign siblings_limit = block.settings.siblings_limit | default: 250
%}

<pdp-siblings
  class="pdp-siblings"
  data-current-handle="{{ picker_product.handle | escape }}"
  data-limit="{{ siblings_limit }}"
  aria-busy="true"
  {{ block.shopify_attributes }}
>
  <script type="application/json" ref="currentProduct">
    {
      "id": {{ picker_product.id | json }},
      "handle": {{ picker_product.handle | json }},
      "title": {{ picker_product.title | json }},
      "url": {{ picker_product.url | json }},
      "tags": {{ picker_product.tags | json }},
      "microCategory": {{ micro_value | json }},
      "pm": {{ pm_value | json }},
      "image": {% if picker_product.featured_image %}{{ picker_product.featured_image | image_url: width: 96 | json }}{% else %}""{% endif %},
      "imageAlt": {{ picker_product.featured_image.alt | default: picker_product.title | json }}
    }
  </script>

  <template ref="chipTemplate">
    <a class="chip" href="#" data-ref="url" data-bind="href" aria-label="">
      <span class="swatch">
        <img data-ref="image" data-bind="src" alt="" loading="lazy" width="18" height="18" hidden>
      </span>
      <span class="chip-label" data-ref="title"></span>
    </a>
  </template>

  <div ref="mount">
    <fieldset class="group siblings" ref="group">
      <div class="head font-mono">
        <span>{{ block.settings.label_color }}</span>
        <span>{{ block.settings.label_variants }}</span>
      </div>
      <div class="tabs font-mono" role="tablist" ref="tablist" hidden>
        {% content_for 'blocks' %}
      </div>
      <div class="panels" ref="panels">
        <div class="panel loading-panel" ref="loadingPanel">
          <div class="values"></div>
        </div>
      </div>
    </fieldset>
  </div>
</pdp-siblings>

{% stylesheet %}
  pdp-siblings.pdp-siblings {
    &[hidden] {
      display: none;
    }

    .panels,
    .panel {
      min-width: 0;
    }

    .panel[hidden] {
      display: none;
    }

    .panel:not([hidden]) {
      display: block;
    }

    .values {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      max-height: calc(32px * 2 + 8px);
      overflow-y: auto;
      padding-right: 4px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      min-height: 32px;
      padding: 0 9px;
      border: 1px solid var(--border-color);
      background: var(--white);
      color: var(--black);
      font-family: var(--font-mono--family);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .chip.is-active {
      border-color: var(--black);
      background: var(--white);
      color: var(--black);
      box-shadow: none;
    }

    .chip-label {
      white-space: nowrap;
    }

    .swatch {
      flex: 0 0 auto;
      width: 18px;
      height: 18px;
      border: 1px solid transparent;
      background: var(--background-darken);
      overflow: hidden;
    }

    .swatch img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .chip.is-active .swatch {
      border-color: var(--black);
    }

    &[aria-busy='true'] .panel:not([hidden]) .values,
    &[aria-busy='true'] .panel.loading-panel .values {
      display: flex;
      gap: 8px;
    }

    &[aria-busy='true'] .panel:not([hidden]) .values::before,
    &[aria-busy='true'] .panel:not([hidden]) .values::after,
    &[aria-busy='true'] .panel.loading-panel .values::before,
    &[aria-busy='true'] .panel.loading-panel .values::after {
      content: '';
      flex: 0 0 auto;
      width: 72px;
      height: 32px;
      border: 1px solid var(--border-color);
      background: var(--background-darken);
    }

    .tabs[hidden] {
      display: none;
    }

    &[aria-busy='true'] .panel[data-tag] {
      display: none;
    }

    label.tab[hidden] {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    pdp-siblings.pdp-siblings {
      .values {
        min-width: 0;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        overscroll-behavior-x: contain;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        width: 100%;
        flex-wrap: nowrap;
        max-height: none;
        padding-right: 0;
        padding-bottom: 4px;
      }

      .values::-webkit-scrollbar {
        display: none;
      }

      .chip {
        flex: 0 0 auto;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Siblings",
  "tag": null,
  "blocks": [
    { "type": "pdp-sibling-tab" }
  ],
  "settings": [
    {
      "type": "range",
      "id": "siblings_limit",
      "label": "Siblings limit",
      "min": 50,
      "max": 250,
      "step": 50,
      "default": 250
    },
    {
      "type": "text",
      "id": "label_color",
      "label": "Color label",
      "default": "Color"
    },
    {
      "type": "text",
      "id": "label_variants",
      "label": "Variants label",
      "default": "Variants"
    }
  ],
  "presets": [
    {
      "name": "Siblings",
      "category": "Product"
    }
  ]
}
{% endschema %}
