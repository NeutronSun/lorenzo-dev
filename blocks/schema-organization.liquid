{% liquid
  assign org_name = section.settings.org_name | default: shop.name
  assign org_url = shop.url
  assign org_logo = section.settings.org_logo
  assign org_email = section.settings.org_email
  assign org_phone = section.settings.org_phone
  assign org_description = section.settings.org_description
%}

{% capture contact_points %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture same_as %}
  {%- assign same_as_started = false -%}
  {%- if section.settings.instagram != blank -%}
    {%- assign social_url = section.settings.instagram | downcase -%}
    {%- if social_url contains 'instagram.com' -%}
      {{ section.settings.instagram | json }}
      {%- assign same_as_started = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.facebook != blank -%}
    {%- assign social_url = section.settings.facebook | downcase -%}
    {%- if social_url contains 'facebook.com' or social_url contains 'fb.com' -%}
      {%- if same_as_started -%},{%- endif -%}
      {{ section.settings.facebook | json }}
      {%- assign same_as_started = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.tiktok != blank -%}
    {%- assign social_url = section.settings.tiktok | downcase -%}
    {%- if social_url contains 'tiktok.com' -%}
      {%- if same_as_started -%},{%- endif -%}
      {{ section.settings.tiktok | json }}
      {%- assign same_as_started = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.youtube != blank -%}
    {%- assign social_url = section.settings.youtube | downcase -%}
    {%- if social_url contains 'youtube.com' or social_url contains 'youtu.be' -%}
      {%- if same_as_started -%},{%- endif -%}
      {{ section.settings.youtube | json }}
      {%- assign same_as_started = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.x != blank -%}
    {%- assign social_url = section.settings.x | downcase -%}
    {%- if social_url contains 'x.com' or social_url contains 'twitter.com' -%}
      {%- if same_as_started -%},{%- endif -%}
      {{ section.settings.x | json }}
      {%- assign same_as_started = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.linkedin != blank -%}
    {%- assign social_url = section.settings.linkedin | downcase -%}
    {%- if social_url contains 'linkedin.com' -%}
      {%- if same_as_started -%},{%- endif -%}
      {{ section.settings.linkedin | json }}
    {%- endif -%}
  {%- endif -%}
{% endcapture %}

,
{
  "@type": "Organization",
  "@id": {{ org_url | append: '#organization' | json }},
  "name": {{ org_name | json }},
  "url": {{ org_url | json }}
  {%- if org_logo != blank -%}
  ,
  "logo": {{ org_logo | image_url: width: 600 | prepend: 'https:' | json }}
  {%- endif -%}
  {%- if org_email != blank -%}
  ,
  "email": {{ org_email | json }}
  {%- endif -%}
  {%- if org_phone != blank -%}
  ,
  "telephone": {{ org_phone | json }}
  {%- endif -%}
  {%- if org_description != blank -%}
  ,
  "description": {{ org_description | json }}
  {%- endif -%}
  {% render 'schema-contact-point-array', items: contact_points %}
  {%- assign same_as_json = same_as | strip -%}
  {%- if same_as_json != blank -%}
  ,
  "sameAs": [{{ same_as_json }}]
  {%- endif -%}
}

{% schema %}
{
  "name": "Organization",
  "blocks": [{ "type": "schema-contact-point" }],
  "settings": [],
  "tag": null,
  "presets": [
    {
      "name": "Organization",
      "blocks": [
        {
          "type": "schema-contact-point",
          "settings": {
            "contact_type": "customer support",
            "telephone": "+39 329 823 6955",
            "languages": "Italian, English"
          }
        },
        {
          "type": "schema-contact-point",
          "settings": {
            "contact_type": "sales",
            "telephone": "+39 329 823 6955"
          }
        }
      ]
    }
  ]
}
{% endschema %}
