{% doc %}
  Renders product card labels.

  @param {product} product - Product object
  @param {string} attributes - Optional attributes for the product-card-labels element
{% enddoc %}

{% liquid
  assign now = 'now' | date: '%s' | times: 1
  assign created_at = product.created_at | date: '%s' | times: 1
  assign new_in_threshold = 30 | times: 24 | times: 60 | times: 60
  assign product_age = now | minus: created_at
  assign is_new_in = false

  if product_age <= new_in_threshold
    assign is_new_in = true
  endif

  assign rarity_handle = product.metafields.valeverce.rarity.value.system.handle | default: ''
  assign theme_handle = product.metafields.valeverce.theme.value | handleize | downcase
  assign is_sold_out = false

  unless product.available
    assign is_sold_out = true
  endunless
%}

{% if is_new_in or is_sold_out or rarity_handle != blank or theme_handle != blank %}
  <product-card-labels
    {{ attributes }}
    {% if is_new_in %}data-new-in{% endif %}
    {% if is_sold_out %}data-sold-out{% endif %}
    data-rarity-handle="{{ rarity_handle }}"
    data-theme-handle="{{ theme_handle }}"
  ></product-card-labels>
{% endif %}

{% stylesheet %}
  product-card-labels {
    --theme-logo-size: 48px;

    position: absolute;
    inset: 10px;
    z-index: 3;
    pointer-events: none;

    [data-labels-stack] {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      max-width: calc(100% - var(--theme-logo-size) - 10px);
    }

    [data-label] {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-height: 24px;
      padding: 0 8px;
      border: 1px solid rgb(0 0 0 / 0.08);
      background: rgb(255 255 255 / 0.92);
      color: var(--black);
      font-family: var(--font-mono--family);
      font-style: var(--font-mono--style);
      font-weight: 400;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    [data-swatch] {
      width: 8px;
      height: 8px;
      border: 1px solid var(--border-color);
      border-radius: 999px;
      background: var(--rarity-color, var(--black));
    }

    [data-label][data-sold-out] {
      --rarity-color: var(--red);
    }

    [data-theme-logo] {
      position: absolute;
      top: 0;
      right: 0;
      display: block;
      width: var(--theme-logo-size);
      height: var(--theme-logo-size);
      object-fit: contain;
    }
  }
{% endstylesheet %}
