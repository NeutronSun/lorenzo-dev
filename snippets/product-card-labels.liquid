{% doc %}
  Renders product card labels.

  @param {product} product - Product object
  @param {boolean} show_new_in - Show new in label
  @param {boolean} show_sold_out - Show sold out label
  @param {boolean} show_rarity - Show rarity label
  @param {string} attributes - Optional attributes for the product-card-labels element
{% enddoc %}

{% liquid
  assign rarity = product.metafields.valeverce.rarity.value
  assign rarity_color = rarity.color.value | default: rarity.color
  assign now = 'now' | date: '%s' | times: 1
  assign created_at = product.created_at | date: '%s' | times: 1
  assign new_in_threshold = 30 | times: 24 | times: 60 | times: 60
  assign product_age = now | minus: created_at
  assign is_new_in = false

  if product_age <= new_in_threshold
    assign is_new_in = true
  endif
%}

{% if show_new_in and is_new_in or show_sold_out and product.available == false or show_rarity and rarity != blank %}
  <product-card-labels {{ attributes }}>
    {% if show_new_in and is_new_in %}
      <span class="label">New in</span>
    {% endif %}

    {% if show_sold_out and product.available == false %}
      <span class="label sold-out">
        <span class="swatch"></span>
        Sold out
      </span>
    {% endif %}

    {% if show_rarity and rarity != blank %}
      <span class="label rarity" style="--rarity-color: {{ rarity_color | default: 'var(--black)' }};">
        <span class="swatch"></span>
        {{ rarity.label | default: rarity.name | default: 'Rarity' }}
      </span>
    {% endif %}
  </product-card-labels>
{% endif %}

{% stylesheet %}
  product-card-labels {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    max-width: calc(100% - 20px);

    .label {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-height: 24px;
      padding: 0 8px;
      border: 1px solid rgb(0 0 0 / 0.08);
      background: rgb(255 255 255 / 0.92);
      color: var(--black);
      font-family: var(--font-mono--family);
      font-style: var(--font-mono--style);
      font-weight: 400;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .swatch {
      width: 8px;
      height: 8px;
      border: 1px solid var(--border-color);
      border-radius: 999px;
      background: var(--rarity-color, var(--black));
    }

    .sold-out {
      --rarity-color: var(--red);
    }
  }
{% endstylesheet %}
