{% doc %}
  Preloads the LCP image for product and collection/search grids.

  One resource only: product hero on PDP, first product card image elsewhere.
{% enddoc %}

{% liquid
  assign lcp_image = blank
  assign lcp_width = 720
  assign lcp_widths = '720' | split: ','
  assign lcp_sizes = '(min-width: 750px) 25vw, 50vw'

  case request.page_type
    when 'product'
      assign lcp_image = product.featured_image | default: product.images.first
      assign lcp_width = 1600
      assign lcp_widths = '420,640,820,1100,1400,1600' | split: ','
      assign lcp_sizes = '(min-width: 990px) 50vw, 100vw'

    when 'collection'
      if collection.products.size > 0
        assign lcp_image = collection.products.first.featured_image
      endif

    when 'search'
      if search.performed
        for result in search.results limit: 1
          if result.object_type == 'product' and result.featured_image != blank
            assign lcp_image = result.featured_image
            break
          endif
        endfor
      endif
  endcase
%}

{% if lcp_image != blank %}
  {% capture lcp_srcset %}
    {%- for width in lcp_widths -%}
      {{ lcp_image | image_url: width: width }} {{ width }}w{%- unless forloop.last -%}, {%- endunless -%}
    {%- endfor -%}
  {% endcapture %}

  <link
    rel="preload"
    as="image"
    href="{{ lcp_image | image_url: width: lcp_width }}"
    imagesrcset="{{ lcp_srcset | strip }}"
    imagesizes="{{ lcp_sizes }}"
    fetchpriority="high"
  >
{% endif %}
