
{% for link in menu.links %}
  <details class="header-menu-item" name="header-menu">
    <summary class="font-mono font-12 black">
      <span class="header-menu-item-title">{{ link.title | upcase }}</span>
      <span class="header-menu-item-back">MENU</span>
      {% render 'icon-chevron' %}
    </summary>
    <div class="header-menu-floating">
      <div class="header-menu-floating-header">
        <span class="font-mono font-12">&sect; {{ link.title | upcase }}</span>
      </div>
      <div class="header-menu-floating-content">
        {% for child in link.links %}
          <div class="header-menu-column">
            <a href="{{ child.url }}" class="font-mono font-12">{{ child.title | upcase }}</a>
            <ul>
              {% for child in child.links %}
                {%-liquid
                  assign collection = child.object
                  assign name = collection.title | split: ' - ' | last | strip
                  assign reference = collection.metafields.valeverce.reference.value
                  assign icon = reference.icon.value | default: reference.icon
                  assign color = reference.color.value | default: reference.color
                %}
                <li>
                  <a href="{{ child.url }}" class="font-body font-14 header-menu-link">
                    {% if icon != blank %}
                      <span class="header-menu-link-icon">{{ icon | image_url: width: 720 | image_tag: width: 16, height: 16, loading: 'lazy', alt: name }}</span>
                    {% elsif color != blank %}
                      <span class="header-menu-link-color" style="--header-menu-link-color: {{ color }};"></span>
                    {% endif %}
                    <span class="header-menu-link-label">{{ name | capitalize }}</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </div>
  </details>
{% endfor %}


{% stylesheet %}
  sticky-header {
    .header-menu-item {
      &[open] {
        summary {
          background-color: transparent;
          svg {
            transform: rotate(180deg);
          }
        }
      }
      summary {
        list-style: none;
        padding: 0;
        margin: 0;
        letter-spacing: 1.6px;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 10px;
        position: relative;
        z-index: 2;

        &::-webkit-details-marker {
          display: none;
        }

        .header-menu-item-back {
          display: none;
        }

        .header-menu-item-title {
          order: 1;
        }

        svg {
          order: 2;
          height: 12px;
          width: 12px;
          transition: transform var(--motion-fast) var(--ease-in-out);
        }
      }
      .header-menu-floating {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        width: 100%;
        background-color: var(--white);
        border: 1px solid var(--border-color);

          .header-menu-floating-header {
            padding: 10px 20px;
            border-bottom: 1px solid var(--border-color);
          }
          .header-menu-floating-content {
            padding: 20px;
            display: flex;
            gap: 20px;
          }
          .header-menu-column {
            display: flex;
            flex-direction: column;
            gap: 10px;
          }

          .header-menu-link {
            color: var(--black);
            display: flex;
            align-items: center;
            gap: 4px;

            .header-menu-link-icon,
            .header-menu-link-color {
              flex: 0 0 16px;
              width: 16px;
              height: 16px;
              transition:
                opacity var(--motion-base) var(--ease-base),
                transform var(--motion-base) var(--ease-base);
            }

            .header-menu-link-icon img {
              display: block;
              width: 100%;
              height: 100%;
              object-fit: contain;
            }

            .header-menu-link-color {
              display: inline-block;
              border: 1px solid var(--border-color);
              background: var(--header-menu-link-color, var(--background-darken));
            }

            &:hover {
              text-decoration: underline;
              text-underline-offset: 2px;
            }
          }
      }
    }

    @media screen and (max-width: 749px) {
      .header-menu-item {
        border-bottom: 1px solid var(--border-color);

        summary {
          font-family: var(--font-body--family);
          font-weight: var(--font-body--weight);
          letter-spacing: normal;
          min-height: 57px;
          padding: 14px 18px;
          justify-content: space-between;
          width: 100%;
          color: var(--black);
          font-size: 16px;

          svg {
            transform: rotate(-90deg);
          }
        }

        &[open] {
          position: absolute;
          inset: 0 0 var(--header-mobile-menu-footer-height);
          z-index: 4;
          display: flex;
          flex-direction: column;
          background-color: var(--white);
          border-bottom: none;

          summary {
            order: -1;
            flex-shrink: 0;
            background-color: transparent;
            font-family: var(--font-mono--family);
            font-weight: 100;
            letter-spacing: 0.25em;
            font-size: 12px;
            gap: 8px;
            min-height: var(--header-mobile-menu-header-height);
            justify-content: flex-start;
            border-bottom: 1px solid var(--border-color);
            padding: 0 16px;
            color: var(--secondary-black);

            .header-menu-item-title {
              display: none;
            }

            .header-menu-item-back {
              display: inline;
              order: 2;
            }

            svg {
              order: 1;
              transform: rotate(90deg);
            }
          }

          .header-menu-floating {
            position: static;
            flex: 1 1 auto;
            overflow-y: auto;
            border: none;
            top: auto;
          }

          .header-menu-floating-header {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            height: var(--header-mobile-menu-header-height);
            padding: 0;
            border: none;
            pointer-events: none;
          }

          .header-menu-floating-content {
            flex-direction: column;
            padding: 0;
            gap: 0;
            overflow-y: auto;
            max-height: calc(100dvh - var(--header-mobile-menu-footer-height) - var(--header-mobile-menu-header-height) - var(--header-mobile-bar-height) - 60px);
          }

          .header-menu-column {
            gap: 0;

            > .font-mono {
              display: block;
              padding: 18px 16px 8px;
              letter-spacing: 0.2em;
              color: var(--secondary-black);
              position: sticky;
              top: 0;
              background-color: var(--white);
            }

            > ul {
              list-style: none;
              margin: 0;
              padding: 0;
            }

            > ul > li {
              border-bottom: 1px solid var(--border-color);
            }

            .header-menu-link {
              display: flex;
              align-items: center;
              justify-content: space-between;
              min-height: 40px;
              padding: 10px 16px;
              text-decoration: none;

              &::after {
                content: '›';
                font-size: 14px;
                color: var(--secondary-black);
              }

              &:hover {
                text-decoration: none;
                background-color: var(--background-darken);
              }

              .header-menu-link-label {
                margin-right: auto;
              }
            }
          }
        }

        &[open] ~ .header-menu-item {
          display: none;
        }
      }

      &:has(.header-menu-item[open]) .header-menu-item:not([open]) {
        display: none;
      }
    }
  }
{% endstylesheet %}
