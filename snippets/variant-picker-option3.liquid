{% doc %}
  @param {product} product
  @param {variant} selected
{% enddoc %}

<fieldset class="group" data-option="3" ref="options[]">
  <legend class="font-mono">{{ product.options[2] }}</legend>

  <div class="tabs font-mono">
    {% assign seen = '' %}

    {% for v in product.variants %}
      {% capture key %}|{{ v.option3 }}|{% endcapture %}

      {% unless seen contains key %}
        {% assign seen = seen | append: key %}

        {% capture attrs %}
          {% render 'variant-picker-option3-attrs', product: product, value: v.option3 %}
        {% endcapture %}

        <label class="tab">
          <input
            type="radio"
            name="option-3"
            value="{{ v.option3 }}"
            {{ attrs | strip }}
            {% if v.option3 == selected.option3 %}checked{% endif %}>

          <span>{{ v.option3 }}</span>
        </label>
      {% endunless %}
    {% endfor %}
  </div>
</fieldset>
