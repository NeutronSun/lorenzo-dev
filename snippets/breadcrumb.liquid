{% doc %}
  Renders breadcrumb navigation from product, collection, or page context.

  @param {boolean} [section_layout] - Section grid layout with view transition
  @param {string} [attributes] - Optional HTML attributes for the root element
{% enddoc %}

<pdp-breadcrumb
  {% if section_layout %}
    class="section"
    data-pdp-breadcrumb
    style="view-transition-name: product-breadcrumb;"
  {% endif %}
  {{ attributes }}
>
  {%- render 'breadcrumb-nav', section_layout: section_layout, bar: true -%}
</pdp-breadcrumb>

{% stylesheet %}
  pdp-breadcrumb.section {
    display: grid;
    grid-template-columns: var(--content-grid);
    background: var(--background);

    .bar {
      grid-column: 2;
    }
  }
{% endstylesheet %}
