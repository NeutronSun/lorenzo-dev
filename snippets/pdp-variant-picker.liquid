{% doc %}
  Renders PDP product siblings picker.

  @param {product} product - Product object
{% enddoc %}

{% liquid
  assign theme_tag = blank
  assign pm_value = product.metafields.valeverce.pm.value | default: product.metafields.valeverce.pm
  assign micro_value = product.metafields.elastick.filter_microcategory.value | default: product.metafields.elastick.filter_microcategory | default: product.metafields.valeverce.micro_category.value | default: product.metafields.valeverce.micro_category
  assign siblings_limit = 250
  assign theme_prefix = 'Tema_'
  assign theme_prefix_size = theme_prefix.size

  for tag in product.tags
    assign theme_tag_prefix = tag | slice: 0, theme_prefix_size

    if theme_tag == blank and theme_tag_prefix == theme_prefix
      assign theme_tag = tag
    endif
  endfor
%}

<pdp-siblings
  data-theme-tag="{{ theme_tag | escape }}"
  data-current-handle="{{ product.handle | escape }}"
  data-current-url="{{ product.url | escape }}"
  data-limit="{{ siblings_limit }}"
  data-label-color="Color"
  data-label-variants="Variants"
  data-label-theme="Tema"
  data-label-fusion="Fusion"
  class="{% if theme_tag != blank %}is-loading{% endif %}"
  aria-busy="{% if theme_tag != blank %}true{% else %}false{% endif %}"
  {% if theme_tag == blank %}hidden{% endif %}
>
  {% if theme_tag != blank %}
    <script type="application/json" ref="currentProduct">
      {
        "id": {{ product.id | json }},
        "handle": {{ product.handle | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "tags": {{ product.tags | json }},
        "microCategory": {{ micro_value | json }},
        "pm": {{ pm_value | json }},
        "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 96 | json }}{% else %}""{% endif %},
        "imageAlt": {{ product.featured_image.alt | default: product.title | json }}
      }
    </script>

    <template ref="groupTemplate">
      <div class="group">
        <div class="head font-mono">
          <span data-ref="colorLabel"></span>
          <span data-ref="variantsLabel"></span>
        </div>
        <div class="tabs font-mono" role="tablist" ref="tablist"></div>
        <div class="panels" ref="panels"></div>
      </div>
    </template>

    <template ref="tabTemplate">
      <label class="tab" role="tab">
        <input type="radio" value="" data-bind="value" data-attribute="value">
        <span data-ref="label"></span>
      </label>
    </template>

    <template ref="panelTemplate">
      <div class="panel" data-ref="tabName" data-bind="attribute" data-attribute="data-tab">
        <div class="values" ref="values"></div>
      </div>
    </template>

    <template ref="chipTemplate">
      <a class="chip" href="#" data-ref="url" data-bind="href" aria-label="">
        <span class="swatch">
          <img data-ref="image" data-bind="src" alt="" loading="lazy" width="18" height="18" hidden>
        </span>
        <span class="chip-label" data-ref="title"></span>
      </a>
    </template>

    <div ref="mount">
      <div class="group skeleton" aria-hidden="true">
        <div class="head font-mono">
          <span></span>
          <span></span>
        </div>

        <div class="tabs font-mono">
          <span></span>
          <span></span>
        </div>

        <div class="values">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>
  {% endif %}
</pdp-siblings>

{% stylesheet %}
  pdp-siblings {
    display: grid;

    &[hidden] {
      display: none;
    }

    .group {
      display: grid;
      gap: 16px;
      padding: 20px;
      border-bottom: 1px solid var(--border-color);
    }

    .head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      color: var(--secondary-black);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .head span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .tabs {
      display: inline-flex;
      width: fit-content;
      max-width: 100%;
      border: 1px solid var(--border-color);
      background: var(--white);
    }

    .tab {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 72px;
      min-height: 30px;
      padding: 0 14px;
      border-right: 1px solid var(--border-color);
      background: transparent;
      color: var(--secondary-black);
      font: inherit;
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .tab:last-child {
      border-right: 0;
    }

    .tab input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      opacity: 0;
      cursor: inherit;
    }

    .tab span {
      position: relative;
      z-index: 1;
    }

    .tab:has(input:checked) {
      background: var(--background-darken);
      color: var(--black);
    }

    .panel {
      display: none;
    }

    .tabs:has(input[value="theme"]:checked) ~ .panels .panel[data-tab="theme"],
    .tabs:has(input[value="fusion"]:checked) ~ .panels .panel[data-tab="fusion"] {
      border: unset;
      display: block;
    }

    .values {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      max-height: calc(32px * 2 + 8px);
      overflow-y: auto;
      padding-right: 4px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      min-height: 32px;
      padding: 0 9px;
      border: 1px solid var(--border-color);
      background: var(--white);
      color: var(--black);
      font-family: var(--font-mono--family);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .chip.is-active {
      border-color: var(--black);
      background: var(--white);
      color: var(--black);
      box-shadow: none;
    }

    .chip-label {
      white-space: nowrap;
    }

    .swatch {
      flex: 0 0 auto;
      width: 18px;
      height: 18px;
      border: 1px solid transparent;
      background: var(--background-darken);
      overflow: hidden;
    }

    .swatch img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .chip.is-active .swatch {
      border-color: var(--black);
    }

    .skeleton .head span,
    .skeleton .tabs span,
    .skeleton .values span {
      display: block;
      background: linear-gradient(90deg, var(--background-darken), var(--border-color), var(--background-darken));
      background-size: 220% 100%;
      animation: pdp-siblings-skeleton 1100ms var(--ease-in-out) infinite;
    }

    .skeleton .head span {
      width: 72px;
      height: 10px;
    }

    .skeleton .head span:last-child {
      width: 44px;
    }

    .skeleton .tabs span {
      width: 72px;
      height: 30px;
      border: 1px solid var(--border-color);
    }

    .skeleton .values span {
      width: 72px;
      height: 32px;
      border: 1px solid var(--border-color);
    }
  }

  @media screen and (max-width: 749px) {
    pdp-siblings {
      .values {
        flex-wrap: nowrap;
        max-height: none;
        overflow-x: auto;
        overflow-y: hidden;
        padding-right: 0;
        padding-bottom: 4px;
      }

      .chip {
        flex: 0 0 auto;
      }
    }
  }

  @keyframes pdp-siblings-skeleton {
    from {
      background-position: 120% 0;
    }

    to {
      background-position: -120% 0;
    }
  }
{% endstylesheet %}
