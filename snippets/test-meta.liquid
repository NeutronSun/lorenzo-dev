<script>
  window.meta = {
    rarity: {
      {% for meta in metaobjects['rarity'].values %}
        "{{ meta.system.handle }}": {{ meta | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    },
    theme: {
      {% for meta in metaobjects['theme'].values %}
        "{{ meta.system.handle }}": {{ meta | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  }
  </script>