{%- liquid
  assign icon_size = size | default: 20
  assign icon_variant = variant | default: 'default'
-%}

{% if icon_variant == 'alternative' %}
  <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="4" y="4" width="7" height="7"></rect>
    <rect x="13" y="4" width="7" height="7"></rect>
    <rect x="4" y="13" width="7" height="7"></rect>
    <rect x="13" y="13" width="7" height="7"></rect>
  </svg>
{% else %}
  <svg xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="4" y="5" width="3.5" height="14"></rect>
    <rect x="9" y="5" width="3.5" height="14"></rect>
    <rect x="14" y="5" width="3.5" height="14"></rect>
    <rect x="19" y="5" width="1" height="14"></rect>
  </svg>
{% endif %}
