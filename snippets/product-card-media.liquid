{% doc %}
  Renders product card media.

  @param {product} product - Product object
  @param {string} labels - Product card labels HTML
  @param {string} attributes - Optional attributes for the product-card-media element
{% enddoc %}

{% liquid
  assign image_loading = 'lazy'
  assign image_fetchpriority = blank

  if request.page_type == 'collection' and collection.products.first.id == product.id
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  if request.page_type == 'search' and search.performed
    for result in search.results limit: 1
      if result.object_type == 'product' and result.id == product.id
        assign image_loading = 'eager'
        assign image_fetchpriority = 'high'
      endif
    endfor
  endif
%}

<product-card-media ref="media" {{ attributes }}>
  <div class="main-image" data-view-transition="product-image">
    {% if image_fetchpriority != blank %}
      {{
        product.featured_image
        | image_url: width: 720
        | image_tag: loading: image_loading, fetchpriority: image_fetchpriority
      }}
    {% else %}
      {{ product.featured_image | image_url: width: 720 | image_tag: loading: image_loading }}
    {% endif %}
  </div>
  {% if labels != blank %}
    {{ labels }}
  {% else %}
    {% render 'product-card-labels', product: product, attributes: '' %}
  {% endif %}
</product-card-media>

{% stylesheet %}
  product-card-media {
    position: relative;
    display: block;
    aspect-ratio: 251 / 376;
    overflow: hidden;
    background: var(--background-darken);

    .main-image,
    .hover-image {
      height: 100%;
    }

    .main-image img,
    .hover-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition:
        opacity var(--motion-base) var(--ease-base),
        transform var(--motion-slow) var(--ease-emphasized);
      transform-origin: center;
    }
  }

  product-card:hover product-card-media .main-image img,
  product-card:hover product-card-media .hover-image img {
    opacity: 0.96;
    transform: scale(1.015);
  }

  @media (prefers-reduced-motion: reduce) {
    product-card-media .main-image img,
    product-card-media .hover-image img {
      transition: none;
    }
  }
{% endstylesheet %}
