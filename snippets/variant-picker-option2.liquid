{% doc %}
  @param {product} product
  @param {variant} selected
{% enddoc %}

<fieldset class="group" data-option="2" ref="options[]">
  <legend class="font-mono">{{ product.options[1] }}</legend>

  <div class="tabs font-mono">
    {% assign seen = '' %}

    {% for v in product.variants %}
      {% capture key %}|{{ v.option2 }}|{% endcapture %}

      {% unless seen contains key %}
        {% assign seen = seen | append: key %}

        {% capture attrs %}
          {% render 'variant-picker-option2-attrs', product: product, value: v.option2 %}
        {% endcapture %}

        <label class="tab">
          <input
            type="radio"
            name="option-2"
            value="{{ v.option2 }}"
            {{ attrs | strip }}
            {% if v.option2 == selected.option2 %}checked{% endif %}>

          <span>{{ v.option2 }}</span>
        </label>
      {% endunless %}
    {% endfor %}
  </div>
</fieldset>
