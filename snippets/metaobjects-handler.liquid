<script>
  window.metaobjects = {
    rarity: {
      {% for meta in metaobjects['rarity'].values %}
        "{{ meta.system.handle }}": {{ meta | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    },
    theme: {
      {% for meta in metaobjects['theme'].values %}
        "{{ meta.system.handle }}": {
          "name": {{ meta.name | json }},
          "icon": {{ meta.icon.value | image_url: width: 720 | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  };
</script>