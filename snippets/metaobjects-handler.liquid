<style>
  :root {
    {% for meta in metaobjects['rarity'].values %}
      --rarity-{{ meta.system.handle }}: {{ meta.color.value | default: meta.color }};
    {% endfor %}
  }
</style>

<script>
  window.metaobjects = {
    rarity: {
      {% for meta in metaobjects['rarity'].values %}
        "{{ meta.system.handle }}": {{ meta | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    },
    theme: {
      {% for meta in metaobjects['theme'].values %}
        "{{ meta.system.handle }}": {
          "name": {{ meta.name | json }},
          "icon": {{ meta.icon.value | image_url | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  };
</script>