{% doc %}
  Renders PDP product info.

  @param {product} product - Product object
{% enddoc %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign macro_category = product.metafields.valeverce.macro_category.value | default: product.metafields.valeverce.macro_category
%}

<pdp-product-info>
  <section class="panel heading">
    <div class="meta font-mono">
      <span>{{ macro_category | default: product.type }}</span>
      <span>{{ current_variant.sku | default: product.handle }}</span>
    </div>

    <h1>{{ product.title }}</h1>

    <div class="price-row">
      <span class="price">{{ current_variant.price | money }}</span>
      <span class="rate font-mono">or 3x {{ current_variant.price | divided_by: 3 | money }}</span>
    </div>
  </section>

  <section class="panel config">
    <h2 class="font-mono">/Configure</h2>

    {% render 'pdp-variant-picker', product: product %}

    <product-form>
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">

        <button type="submit" class="add font-mono" {% unless current_variant.available %}disabled{% endunless %}>
          {% render 'icon-bag', size: 16 %}
          <span>{% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}</span>
          <span>{{ current_variant.price | money }} -></span>
        </button>
      {% endform %}
    </product-form>

    <p class="shipping font-mono">Free EU shipping &middot; 30-day returns</p>
  </section>

  <section class="panel notes">
    <h2 class="font-mono">/Notes</h2>

    <div class="description">
      {% if product.description != blank %}
        {{ product.description }}
      {% else %}
        <p>{{ product.title }} details will be available soon.</p>
      {% endif %}
    </div>
  </section>
</pdp-product-info>

{% stylesheet %}
  pdp-product-info {
    display: grid;
    gap: 16px;

    .panel {
      border: 1px solid var(--border-color);
      background: var(--white);
      box-shadow: 0 10px 28px rgb(0 0 0 / 0.04);
    }

    .heading {
      display: grid;
      gap: 14px;
      padding: 20px;
    }

    .meta,
    .shipping {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      color: var(--secondary-black);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .meta span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    h1 {
      margin: 0;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border-color);
      color: var(--black);
      font-family: var(--font-body--family);
      font-size: clamp(30px, 4vw, 42px);
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: 0;
    }

    .price-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
    }

    .price {
      color: var(--black);
      font-size: 26px;
      line-height: 1;
    }

    .rate {
      color: var(--secondary-black);
      font-size: 10px;
      letter-spacing: 0.12em;
      white-space: nowrap;
    }

    .config {
      display: grid;
    }

    .config > h2,
    .notes > h2 {
      margin: 0;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-color);
      color: var(--black);
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    product-form {
      display: block;
      padding: 16px 20px 8px;
    }

    .add {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      min-height: 48px;
      padding: 0 16px;
      border: 1px solid var(--black);
      background: var(--black);
      color: var(--white);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .add:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .add svg {
      flex: 0 0 auto;
    }

    .shipping {
      justify-content: center;
      padding: 0 20px 18px;
      font-size: 10px;
    }

    .notes {
      display: grid;
    }

    .description {
      padding: 18px 20px 22px;
      color: var(--secondary-black);
      font-size: 14px;
      line-height: 1.55;
    }

    .description > * {
      margin-block: 0 12px;
    }

    .description > *:last-child {
      margin-bottom: 0;
    }
  }

  @media screen and (max-width: 749px) {
    pdp-product-info {
      h1 {
        font-size: 32px;
      }

      product-form,
      .shipping {
        display: none;
      }
    }
  }
{% endstylesheet %}
