{% doc %}
  Renders a Valerio trait orb with hover label.

  @param {string} letter - Single letter mark
  @param {string} stat - Stat token (v, a, l, e, r, i, o)
  @param {string} label - Trait name
  @param {string} value - Trait value
{% enddoc %}

<button type="button" class="trait" aria-label="{{ label | escape }}">
  <span class="stats stat-{{ stat }} orb">
    <span class="num font-mono">{{ value }}</span>
    <span class="mark font-mono" aria-hidden="true">{{ letter }}</span>
    <span class="tip font-mono">{{ label }}</span>
  </span>
</button>
