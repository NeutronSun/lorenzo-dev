{% doc %}
  @param {product} product
  @param {variant} [variant] - Resolved in sections/product.liquid
  @param {string} [source] - Event source (e.g. pdp), set via Liquid only
{% enddoc %}

{% unless product.has_only_default_variant %}
  {% assign selected = variant %}

  <variant-picker{% if source != blank %} data-source="{{ source }}"{% endif %}>
    {% render 'variant-picker-option', product: product, selected: selected, option_index: 1 %}

    {% if product.options.size > 1 %}
      {% render 'variant-picker-option', product: product, selected: selected, option_index: 2 %}
    {% endif %}

    {% if product.options.size > 2 %}
      {% render 'variant-picker-option', product: product, selected: selected, option_index: 3 %}
    {% endif %}

    <script type="application/json" ref="variants">
      {{ product.variants | json }}
    </script>
  </variant-picker>

  {% stylesheet %}
    variant-picker {
      --option-disabled-opacity: 0.35;
    }

    variant-picker label.tab[data-option-state="unavailable"] {
      --opacity: var(--option-disabled-opacity);
      --pointer-events: none;
      --cursor: not-allowed;
    }

    variant-picker label.tab[data-option-state="available"] {
      --opacity: 1;
      --color: var(--black);
      --pointer-events: auto;
      --cursor: pointer;
    }

    variant-picker label.tab[data-option-state="sold-out"] {
      --opacity: 1;
      --color: var(--black);
      --decoration: line-through;
      --pointer-events: auto;
      --cursor: pointer;
    }
  {% endstylesheet %}
{% endunless %}
