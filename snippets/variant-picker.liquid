{% liquid
  assign selected = product.selected_or_first_available_variant
%}

<variant-picker>
  {% render 'variant-picker-option1', product: product, selected: selected %}

  {% if product.options.size > 1 %}
    {% render 'variant-picker-option2', product: product, selected: selected %}
  {% endif %}

  {% if product.options.size > 2 %}
    {% render 'variant-picker-option3', product: product, selected: selected %}
  {% endif %}

  <script type="application/json" ref="variants">
    {{ product.variants | json }}
  </script>
</variant-picker>

{% render 'variant-picker-styles', product: product %}

{% stylesheet %}
  variant-picker {
    --option-disabled-opacity: 0.4;
    --option-sold-out-opacity: 0.5;

    fieldset[data-option="2"] label,
    fieldset[data-option="3"] label {
      opacity: var(--option-disabled-opacity);
      pointer-events: none;
      cursor: not-allowed;
    }

    label:has(input[data-sold-out]) {
      text-decoration: line-through;
      opacity: var(--option-sold-out-opacity);
    }
  }
{% endstylesheet %}
