{% doc %}
  Renders breadcrumb navigation from a link list menu and optional target handle.

  @param {string} [target] - Object handle to match in the menu tree
  @param {boolean} [searching] - Skips product collection recursion when true
  @param {boolean} [section_layout] - Applies page-width layout class
  @param {string} [separator] - Separator between breadcrumb items
  @param {string} [align] - Flex justify-content value for the bar
  @param {boolean} [style_typography] - Applies theme typography inline styles when true
{% enddoc %}

{%- liquid
  assign menu = linklists[settings.breadcrumbs_linklist] | default: linklists.breadcrumbs

  assign breadcrumbs = '' | split: ','
  assign target = target | default: blank
  assign searching = searching | default: false
  assign separator = separator | default: settings.breadcrumbs_separator | default: '/'
  assign style_typography = style_typography | default: true, allow_false: true
  assign align = align | default: settings.breadcrumbs_align | default: 'flex-start'

  if product and searching == false
    for collection in product.collections
      capture result
        render 'breadcrumb-nav', target: collection.handle, searching: true, separator: separator, align: align, style_typography: style_typography
      endcapture
      if result != ''
        break
      endif
    endfor
    echo result
  else
    if target == blank
      if collection
        assign target = collection.handle
      elsif article
        assign target = article.handle
      elsif page
        assign target = page.handle
      endif
    endif

    for link in menu.links
      assign object_1 = blank | default: title: link.title, url: link.url | sort
      assign h1 = link.object.handle

      if h1 == target
        assign breadcrumbs = breadcrumbs | concat: object_1
        break
      endif

      if link.links and link.links.size > 0
        for l2 in link.links
          assign object_2 = blank | default: title: l2.title, url: l2.url | sort
          assign h2 = l2.object.handle | split: '/' | last

          if h2 == target
            assign breadcrumbs = breadcrumbs | concat: object_1 | concat: object_2
            break
          endif

          if l2.links and l2.links.size > 0
            for l3 in l2.links
              assign object_3 = blank | default: title: l3.title, url: l3.url | sort
              assign h3 = l3.object.handle

              if h3 == target
                assign breadcrumbs = breadcrumbs | concat: object_1 | concat: object_2 | concat: object_3
                break
              endif
            endfor
          endif

          if breadcrumbs.size > 0
            break
          endif
        endfor
      endif

      if breadcrumbs.size > 0
        break
      endif
    endfor

    if breadcrumbs.size > 0
      if settings.breadcrumbs_home != blank
        assign object_home = blank | default: title: settings.breadcrumbs_home, url: routes.root_url | sort
        assign breadcrumbs = object_home | concat: breadcrumbs
      endif
      if product and settings.breadcrumbs_show_leaf
        assign object_product = blank | default: title: product.title, url: product.url | sort
        assign breadcrumbs = breadcrumbs | concat: object_product
      endif
    endif
  endif
-%}

{%- if breadcrumbs.size > 0 -%}
  {%- liquid
    assign nav_style = '--breadcrumb-align: ' | append: align | append: ';'

    if style_typography
      assign nav_style = nav_style | append: ' --breadcrumb-font-size: ' | append: settings.breadcrumbs_text_size | append: 'px;'
      assign nav_style = nav_style | append: ' --breadcrumb-color: ' | append: settings.breadcrumbs_text_color | append: ';'
      if settings.breadcrumbs_text_transform != blank
        assign nav_style = nav_style | append: ' --breadcrumb-text-transform: ' | append: settings.breadcrumbs_text_transform | append: ';'
      endif
    endif
  -%}
  <nav
    class="breadcrumb-nav bar{% if section_layout %} page-width{% endif %}"
    aria-label="Breadcrumb"
    style="{{ nav_style | strip }}"
  >
    {%- for breadcrumb in breadcrumbs -%}
      {%- capture breadcrumb_html -%}
        <a href="{{ breadcrumb.url }}">{{ breadcrumb.title }}</a>
      {%- endcapture -%}
      {%- if forloop.last -%}
        <h1 class="breadcrumb-leaf">{{ breadcrumb_html }}</h1>
      {%- else -%}
        {{ breadcrumb_html }}
      {%- endif -%}
      {%- unless forloop.last -%}
        <span class="separator" aria-hidden="true">{{ separator }}</span>
      {%- endunless -%}
    {%- endfor -%}
  </nav>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {%- for breadcrumb in breadcrumbs -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "item": {
              "@id": "{{ shop.url }}{%- unless breadcrumb.url contains routes.root_url -%}{{ routes.root_url }}{%- endunless -%}{{ breadcrumb.url }}",
              "name": {{ breadcrumb.title | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .breadcrumb-nav.bar {
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 36px;
    padding-inline: 16px;
    border: 1px solid var(--border-color);
    background: var(--white);
    color: var(--breadcrumb-color, inherit);
    font-size: var(--breadcrumb-font-size, inherit);
    text-transform: var(--breadcrumb-text-transform, inherit);
    justify-content: var(--breadcrumb-align, flex-start);
    overflow: hidden;
  }

  .breadcrumb-nav.bar a,
  .breadcrumb-nav.bar span,
  .breadcrumb-nav.bar h1 {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font: inherit;
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .breadcrumb-nav.bar .breadcrumb-leaf {
    font: inherit;
  }

  .breadcrumb-nav.bar .separator {
    flex: 0 0 auto;
  }

  @media screen and (min-width: 990px) {
    .breadcrumb-nav.bar {
      padding-inline: 40px;
    }
  }
{% endstylesheet %}
