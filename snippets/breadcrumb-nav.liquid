{% doc %}
  Renders breadcrumb navigation from a link list menu and optional target handle.

  @param {string} [target] - Object handle to match in the menu tree
  @param {boolean} [searching] - Skips product collection recursion when true
  @param {boolean} [section_layout] - Applies page-width layout class
  @param {string} [linklist] - Link list handle for the breadcrumb menu
  @param {string} [separator] - Separator between breadcrumb items
  @param {string} [home] - Home label; omitted when blank
  @param {boolean} [show_leaf] - Appends the current product as the last crumb
  @param {boolean} [bar] - Adds breadcrumb-bar class for section container styling
{% enddoc %}

{%- liquid
  assign menu_handle = linklist | default: settings.breadcrumbs_linklist | default: 'breadcrumbs'
  assign menu = linklists[menu_handle] | default: linklists.breadcrumbs

  assign breadcrumbs = '' | split: ','
  assign target = target | default: blank
  assign searching = searching | default: false
  assign separator = separator | default: settings.breadcrumbs_separator | default: '/'
  assign show_bar = bar | default: false
  
  if home == nil
    assign home_label = settings.breadcrumbs_home
  else
    assign home_label = home
  endif
  assign show_leaf_setting = settings.breadcrumbs_show_leaf
  unless show_leaf == nil
    assign show_leaf_setting = show_leaf
  endunless

  if product and searching == false
   for collection in product.collections
     capture result
       render 'breadcrumb-nav', target: collection.handle, searching: true, linklist: linklist, separator: separator, home: home, show_leaf: show_leaf, bar: show_bar
     endcapture
     if result != blank
      echo result
       break
     endif
   endfor
  else
    if target == blank
      if collection
        assign target = collection.handle
      elsif article
        assign target = article.handle
      elsif page
        assign target = page.handle
      endif
    endif

    for link in menu.links
      assign object_1 = blank | default: title: link.title, url: link.url | sort
      assign h1 = link.object.handle

      if h1 == target
        assign breadcrumbs = breadcrumbs | concat: object_1
        break
      endif

      if link.links and link.links.size > 0
        for l2 in link.links
          assign object_2 = blank | default: title: l2.title, url: l2.url | sort
          assign h2 = l2.object.handle | split: '/' | last

          if h2 == target
            assign breadcrumbs = breadcrumbs | concat: object_1 | concat: object_2
            break
          endif

          if l2.links and l2.links.size > 0
            for l3 in l2.links
              assign object_3 = blank | default: title: l3.title, url: l3.url | sort
              assign h3 = l3.object.handle

              if h3 == target
                assign breadcrumbs = breadcrumbs | concat: object_1 | concat: object_2 | concat: object_3
                break
              endif
            endfor
          endif

          if breadcrumbs.size > 0
            break
          endif
        endfor
      endif

      if breadcrumbs.size > 0
        break
      endif
    endfor

    if breadcrumbs.size > 0
      if home_label != blank
        assign object_home = blank | default: title: home_label, url: routes.root_url | sort
        assign breadcrumbs = object_home | concat: breadcrumbs
      endif
      if product and show_leaf_setting
        assign object_product = blank | default: title: product.title, url: product.url | sort
        assign breadcrumbs = breadcrumbs | concat: object_product
      endif
    endif
  endif
%}

  {%- if breadcrumbs.size > 0 -%}
    <nav
      class="breadcrumb-nav{% if show_bar %} breadcrumb-bar{% endif %}{% if section_layout %} page-width{% endif %}"
      aria-label="Breadcrumb"
    >
      {%- for breadcrumb in breadcrumbs -%}
        {%- capture breadcrumb_html -%}
          <a href="{{ breadcrumb.url }}">{{ breadcrumb.title }}</a>
        {%- endcapture -%}
        {%- if forloop.last -%}
          <h1 class="breadcrumb-leaf">{{ breadcrumb_html }}</h1>
        {%- else -%}
          {{ breadcrumb_html }}
        {%- endif -%}
        {%- unless forloop.last -%}
          <span class="separator" aria-hidden="true">{{ separator }}</span>
        {%- endunless -%}
      {%- endfor -%}
    </nav>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {%- for breadcrumb in breadcrumbs -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "item": {
                "@id": "{{ shop.url }}{%- unless breadcrumb.url contains routes.root_url -%}{{ routes.root_url }}{%- endunless -%}{{ breadcrumb.url }}",
                "name": {{ breadcrumb.title | json }}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}

{% stylesheet %}
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
    text-transform: inherit;
    overflow: hidden;

    :is(a, span, h1) {
      min-width: 0;
      margin: 0;
      overflow: hidden;
      font: inherit;
      color: inherit;
      text-decoration: none;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .breadcrumb-leaf {
      font: inherit;
    }

    .separator {
      flex: 0 0 auto;
    }
  }
{% endstylesheet %}
