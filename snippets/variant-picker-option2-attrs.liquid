{% doc %}
  @param {product} product
  @param {string} value - option2 value
{% enddoc %}

{% liquid
  assign seen = ''
  assign tokens = ''
  assign option1_available = ''
  assign sold_out = ''
  assign sold_out_seen = ''
  assign tokens13 = ''
  assign sold_out13 = ''
  assign seen13 = ''
  assign sold_out13_seen = ''
%}

{% for r in product.variants %}
  {% if r.option2 == value %}
    {% assign token = r.option1 | handleize %}
    {% capture key %}|{{ r.option1 }}|{% endcapture %}
    {% capture token_key %}|{{ token }}|{% endcapture %}

    {% unless seen contains key %}
      {% assign seen = seen | append: key %}
      {% assign tokens = tokens | append: token | append: ' ' %}
    {% endunless %}

    {% if r.available %}
      {% unless option1_available contains token_key %}
        {% assign option1_available = option1_available | append: token_key %}
      {% endunless %}
    {% endif %}

    {% assign token13 = r.option1 | handleize | append: '_' | append: r.option3 | handleize %}
    {% capture key13 %}|{{ token13 }}|{% endcapture %}

    {% unless seen13 contains key13 %}
      {% assign seen13 = seen13 | append: key13 %}
      {% assign tokens13 = tokens13 | append: token13 | append: ' ' %}
    {% endunless %}

    {% unless r.available %}
      {% unless sold_out13_seen contains key13 %}
        {% assign sold_out13_seen = sold_out13_seen | append: key13 %}
        {% assign sold_out13 = sold_out13 | append: token13 | append: ' ' %}
      {% endunless %}
    {% endunless %}
  {% endif %}
{% endfor %}

{% assign seen = '' %}

{% for r in product.variants %}
  {% if r.option2 == value %}
    {% assign token = r.option1 | handleize %}
    {% capture key %}|{{ r.option1 }}|{% endcapture %}
    {% capture token_key %}|{{ token }}|{% endcapture %}

    {% unless seen contains key %}
      {% assign seen = seen | append: key %}

      {% unless option1_available contains token_key %}
        {% unless sold_out_seen contains token_key %}
          {% assign sold_out_seen = sold_out_seen | append: token_key %}
          {% assign sold_out = sold_out | append: token | append: ' ' %}
        {% endunless %}
      {% endunless %}
    {% endunless %}
  {% endif %}
{% endfor %}

data-available-option1="{{ tokens | strip }}"
data-sold-out-option1="{{ sold_out | strip }}"
data-available-option3="{{ tokens13 | strip }}"
data-sold-out-option3="{{ sold_out13 | strip }}"
