{% render 'variables-js' %}

<script type="importmap">
  {
    "imports": {
      "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
      "@theme/header": "{{ 'header.js' | asset_url }}",
      "@theme/HTMLComponent": "{{ 'HTMLComponent.js' | asset_url }}",
      "@theme/dialog": "{{ 'dialog.js' | asset_url }}",
      "@theme/collection": "{{ 'collection.js' | asset_url }}",
      "@theme/product-card": "{{ 'product-card.js' | asset_url }}"
    }
  }
</script>


<link
  rel="modulepreload"
  href="{{ 'utilities.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'header.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'HTMLComponent.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'dialog.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'collection.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'product-card.js' | asset_url }}"
  fetchpriority="low"
>
<script
    src="{{ 'global.js' | asset_url }}"
    defer="defer"
    type="module"
></script>
