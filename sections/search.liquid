{% assign visible_search_terms = search.terms | remove: '*' %}

<section class="search-page">
  <header class="search-page-header">
    <h1>{{ 'search.title' | t }}</h1>
    <search-form>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page-form" on:submit="handleSubmit">
        <input
          ref="query"
          type="search"
          name="q"
          value="{{ visible_search_terms | escape }}"
          placeholder="Search products, collections, SKU..."
        >
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button button-primary font-mono">{{ 'search.submit' | t }}</button>
      </form>
    </search-form>

    {% if search.performed %}
      <p class="search-page-count font-mono">
        {{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %} for “{{ visible_search_terms | escape }}”
      </p>
    {% endif %}
  </header>

  {% if search.performed %}
    {% content_for 'block', type: 'filters', id: 'filters-and-sorting' %}

    <product-grid>
      {% paginate search.results by 18 %}
        {% for product in search.results %}
          {% if product.object_type == 'product' %}
            {% content_for 'block', type: 'product-card', id: 'product-card', product: product %}
          {% endif %}
        {% endfor %}

        {% if search.results_count == 0 %}
          <search-page-empty>
            {% render 'icon-search', size: 38 %}
            <p>No results found for “{{ visible_search_terms | escape }}”</p>
          </search-page-empty>
        {% endif %}

        {{ paginate | default_pagination }}
      {% endpaginate %}
    </product-grid>
  {% endif %}
</section>

{% stylesheet %}
  .search-page {
    display: grid;
    gap: 20px;

    .search-page-header {
      display: grid;
      gap: 12px;
    }

    .search-page-header h1,
    .search-page-count {
      margin: 0;
    }

    search-form,
    .search-page-form {
      width: 100%;
    }

    .search-page-form {
      display: flex;
      align-items: stretch;
      max-width: 720px;
    }

    .search-page-form input[type="search"] {
      flex: 1 1 auto;
      min-width: 0;
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid var(--border-color);
      border-inline-end: 0;
      background: var(--white);
      color: var(--black);
    }

    .search-page-count {
      font-size: 11px;
      text-transform: uppercase;
    }

    search-page-empty {
      grid-column: 1 / -1;
      display: grid;
      place-items: center;
      align-content: center;
      gap: 12px;
      min-height: 320px;
      border: 1px solid var(--border-color);
      background: var(--white);
      text-align: center;
    }

    search-page-empty p {
      margin: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "class": "section page-width",
  "settings": []
}
{% endschema %}
