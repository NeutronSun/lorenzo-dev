{% capture breadcrumb_content %}
  {%- render 'breadcrumb-nav',
    linklist: section.settings.linklist,
    separator: section.settings.separator,
    home: section.settings.home,
    show_leaf: section.settings.show_leaf,
    section_layout: true,
    bar: true
  -%}
{% endcapture %}

<pdp-breadcrumb
  class="section"
  data-pdp-breadcrumb
  style="view-transition-name: product-breadcrumb;"
>
  {% content_for 'block', type: 'text', id: 'text', body: breadcrumb_content %}
</pdp-breadcrumb>

{% stylesheet %}
  pdp-breadcrumb {
    .breadcrumb-nav.breadcrumb-bar {
      min-height: 36px;
      padding-inline: 16px;
      border: 1px solid var(--border-color);
      background: var(--white);
    }

    &.section {
      display: grid;
      grid-template-columns: var(--content-grid);
      background: var(--background);

      .text {
        grid-column: 2;
      }
    }
  }

  @media screen and (min-width: 750px) {
    .breadcrumb-wrapper {
      padding-block: var(--spacing);
    }
  }

  @media screen and (max-width: 749px) {
    .breadcrumb-wrapper {
      padding-block: calc(var(--spacing) + env(safe-area-inset-top, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.breadcrumbs",
  "class": "breadcrumb-wrapper",
  "blocks": [{ "type": "text" }],
  "settings": [
    {
      "type": "link_list",
      "id": "linklist",
      "label": "t:labels.breadcrumbs_linklist"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "t:labels.breadcrumbs_separator",
      "default": "/"
    },
    {
      "type": "text",
      "id": "home",
      "label": "t:labels.breadcrumbs_home",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_leaf",
      "label": "t:labels.breadcrumbs_show_leaf",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.breadcrumbs",
      "blocks": [
        {
          "type": "text",
          "id": "text",
          "static": true,
          "settings": {
            "font": "mono",
            "color": "secondary",
            "font_size": 10,
            "text_transform": "uppercase",
            "alignment": "left"
          }
        }
      ]
    }
  ]
}
{% endschema %}
