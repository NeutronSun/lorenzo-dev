<pdp-breadcrumb class="section" data-pdp-breadcrumb>
  <div class="bar page-width font-mono">
    <span>Home</span>
    <span>/</span>
    <span>Catalog</span>
    <span>/</span>
    <span>{{ product.title | default: 'Product' }}</span>
  </div>
</pdp-breadcrumb>

{% stylesheet %}
  pdp-breadcrumb {
    position: sticky;
    top: calc(var(--header-height, 0px) + var(--spacing));
    z-index: calc(var(--z-index-header) - 1);
    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: 0;
    background: var(--background);

    .bar {
      grid-column: 2;
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 36px;
      padding: 0 16px;
      border: 1px solid var(--border-color);
      background: var(--white);
      color: var(--secondary-black);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      overflow: hidden;
    }

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  @media screen and (max-width: 749px) {
    pdp-breadcrumb {
      top: var(--spacing);
      padding-block: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Breadcrumb",
  "class": "breadcrumb-wrapper",
  "settings": [],
  "presets": [
    {
      "name": "PDP Breadcrumb"
    }
  ]
}
{% endschema %}
