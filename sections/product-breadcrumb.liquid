{% render 'breadcrumb',
  separator: section.settings.separator,
  section_layout: true
%}

{% stylesheet %}
  @media screen and (min-width: 750px) {
    .breadcrumb-wrapper {
      position: sticky;
      top: calc(var(--header-height, 0px) + var(--spacing));
      z-index: 30;
      padding-block: var(--spacing);
    }
  }

  @media screen and (max-width: 749px) {
    .breadcrumb-wrapper {
      position: sticky;
      top: 0;
      z-index: 30;
      padding-block: calc(var(--spacing) + env(safe-area-inset-top, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Breadcrumbs",
  "class": "breadcrumb-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "/"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs"
    }
  ]
}
{% endschema %}
