<sticky-header>
  <header ref="header">
    <div class="header-left">
      <a href="{{ routes.root_url }}" class="header-logo">
        <img src="{{ settings.logo | image_url: width: 100 }}" alt="{{ shop.name }}" width="100" height="100">
      </a>
    </div>
    <div class="header-center">
      {% render 'header-menu', menu: section.settings.menu %}
    </div>
    <div class="header-right header-group">
      oid
    </div>
  </header>
</sticky-header>

{% stylesheet %}
  .uyn-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: transparent;

    sticky-header {
      margin-top: var(--header-spacing-top);
      padding: 6px 12px;
      background-color: var(--white);
      border: 1px solid var(--border-color);
      position: relative;

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;

        .header-logo img {
          filter: invert(1);
        }

        .header-group {
          flex: 0 0 auto;
        }

        .header-center {
          /* position: absolute;
          top: 0;
          bottom: 0;
          left: 50%;
          transform: translateX(-50%); */
          display: flex;
          align-items: center;
          flex: 1 1 auto;
          justify-content: start;
          border-inline: 1px solid var(--border-color);
          padding-inline: 16px;
        }

        .header-link {
          text-decoration: none;
          color: var(--black);
        }

        .header-group:has(.header-link:hover) {
          .header-link {
            color: oklch(from var(--white) var(--disabled-l) var(--disabled-c) h);

            &:hover {
              color: var(--white);
            }
          }
        }
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UYN Header",
  "class": "uyn-header section page-width",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ],
  "presets": [
    {
      "name": "UYN Header"
    }
  ]
}
{% endschema %}
