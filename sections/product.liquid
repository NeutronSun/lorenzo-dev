{% comment %}
  Product page section without breadcrumb.
{% endcomment %}

<product-page class="section">
  <div class="layout page-width">
    {% content_for 'block', type: 'pdp-product-dossier', id: 'dossier', product: product %}
    {% content_for 'block', type: 'pdp-gallery', id: 'gallery', product: product %}
    {% content_for 'block', type: 'pdp-product-info', id: 'info', product: product %}
  </div>
</product-page>

{% stylesheet %}
  product-page {
    --layout-gap: 20px;
    --gallery-gap: 20px;
    --safe-area-top: env(safe-area-inset-top, 0px);
    --sticky-top: calc(var(--header-height, 0px) + var(--breadcrumb-height, 0px) + var(--spacing));
    --pdp-card-height: max(0px, calc(100dvh - var(--sticky-top) - var(--spacing)));
    --thumb-size: clamp(92px, 10vw, 142px);

    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: var(--spacing);

    .layout {
      grid-column: 2;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--layout-gap);
    }

    .pdp-product-dossier,
    .pdp-gallery,
    .pdp-product-info {
      width: 100%;
      min-width: 0;
    }
  }

  @media screen and (min-width: 990px) {
    product-page {
      .layout {
        flex-direction: row;
      }

      .pdp-product-dossier,
      .pdp-product-info {
        flex: 1 1 260px;
        position: sticky;
        top: var(--sticky-top);
        align-self: start;
        width: auto;
        max-height: var(--pdp-card-height);
        overflow: auto;
      }

      .pdp-gallery {
        flex: 1.35 1 360px;
        width: auto;
      }
    }
  }

  @media screen and (max-width: 989px) {
    product-page {
      .pdp-gallery {
        order: 1;
      }

      .pdp-product-info {
        order: 2;
      }

      .pdp-product-dossier {
        order: 3;
      }
    }
  }

  @media screen and (max-width: 749px) {
    product-page {
      --thumb-size: clamp(72px, 21vw, 92px);
      --sticky-top: calc(var(--breadcrumb-height, 0px) + var(--spacing));

      .layout {
        gap: 16px;
      }

      .pdp-gallery {
        position: static;
        top: auto;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "blocks": [
    { "type": "pdp-product-dossier" },
    { "type": "pdp-gallery" },
    { "type": "pdp-product-info" }
  ],
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
