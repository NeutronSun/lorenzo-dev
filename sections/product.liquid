{% comment %}
  Product page section without breadcrumb.
{% endcomment %}

<product-page class="section">
  <div class="layout page-width">
    {% content_for 'block', type: 'pdp-gallery', id: 'gallery', product: product %}
    {% content_for 'block', type: 'pdp-product-info', id: 'info', product: product %}
  </div>
</product-page>

{% stylesheet %}
  product-page {
    --gap: 16px;
    --sticky-top: calc(var(--header-height, 0px) + var(--breadcrumb-height, 0px) + var(--spacing));
    --gallery-height: calc(100dvh - var(--sticky-top) - var(--spacing));
    --main-height: calc(var(--gallery-height) - var(--thumb-size) - var(--gap));
    --thumb-size: clamp(96px, 11vw, 164px);

    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: var(--spacing);

    .layout {
      grid-column: 2;
      display: flex;
      align-items: flex-start;
      gap: var(--gap);
    }

    pdp-gallery {
      position: sticky;
      top: var(--sticky-top);
      flex: 1 1 auto;
      min-width: 0;
    }

    pdp-product-info {
      flex: 0 0 clamp(320px, 30vw, 420px);
      min-width: 0;
    }
  }

  @media screen and (max-width: 749px) {
    product-page {
      --thumb-size: clamp(72px, 21vw, 92px);
      --sticky-top: calc(var(--spacing) + var(--breadcrumb-height, 0px) + var(--spacing));
      --gallery-height: calc(100dvh - var(--sticky-top) - var(--dock-clearance, 86px));
      --main-height: calc(var(--gallery-height) - var(--thumb-size) - 12px);

      padding-block: 0 calc(var(--dock-clearance, 86px) + var(--spacing));

      .layout {
        display: grid;
        gap: 16px;
      }

      pdp-product-info {
        width: 100%;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "blocks": [
    { "type": "pdp-gallery" },
    { "type": "pdp-product-info" }
  ],
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
