{% comment %}
  Product page section without breadcrumb.
{% endcomment %}

<product-page class="section">
  <div class="layout page-width">
    {% content_for 'block', type: 'pdp-gallery', id: 'gallery', product: product %}
    {% content_for 'block', type: 'pdp-product-info', id: 'info', product: product %}
  </div>
</product-page>

{% stylesheet %}
  product-page {
    --layout-gap: 16px;
    --gallery-gap: 12px;
    --safe-area-top: env(safe-area-inset-top, 0px);
    --safe-area-bottom: env(safe-area-inset-bottom, 0px);
    --sticky-top: calc(var(--header-height, 0px) + var(--breadcrumb-height, 0px) + var(--spacing));
    --gallery-height: calc(100dvh - var(--sticky-top) - var(--spacing));
    --main-height: max(0px, calc(var(--gallery-height) - var(--thumb-size) - var(--gallery-gap)));
    --thumb-size: clamp(96px, 11vw, 164px);

    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: var(--spacing);

    .layout {
      grid-column: 2;
      display: flex;
      align-items: flex-start;
      gap: var(--layout-gap);
    }

    pdp-gallery {
      flex: 1 1 auto;
      min-width: 0;
    }

    pdp-product-info {
      flex: 0 0 clamp(320px, 30vw, 420px);
      min-width: 0;
    }
  }

  @media screen and (min-width: 750px) {
    product-page {
      pdp-gallery {
        position: sticky;
        top: var(--sticky-top);
        align-self: flex-start;
      }
    }
  }

  @media screen and (max-width: 749px) {
    product-page {
      --thumb-size: clamp(72px, 21vw, 92px);
      --dock-clearance-fallback: calc(var(--header-mobile-bar-height, 58px) + var(--header-mobile-menu-gap, 8px) + var(--spacing) + var(--safe-area-bottom));
      --sticky-top: calc(var(--breadcrumb-height, 0px) + var(--spacing));
      --gallery-height: calc(100dvh - var(--sticky-top) - var(--dock-clearance, var(--dock-clearance-fallback)));
      --main-height: max(0px, calc(var(--gallery-height) - var(--thumb-size) - var(--gallery-gap)));

      padding-block: var(--spacing) calc(var(--dock-clearance, var(--dock-clearance-fallback)) + var(--spacing));

      .layout {
        display: grid;
        gap: var(--dock-clearance, var(--dock-clearance-fallback));
      }

      pdp-product-info {
        width: 100%;
      }

      pdp-gallery {
        position: static;
        top: auto;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "blocks": [
    { "type": "pdp-gallery" },
    { "type": "pdp-product-info" }
  ],
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
