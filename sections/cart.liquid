{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<cart-page class="section" data-section-id="{{ section.id }}">
  <div class="cart-page-layout page-width">
    <div class="cart-page-main">
      <header class="cart-page-header">
        <p class="cart-page-eyebrow font-mono">/BAG</p>
        <h1>{{ 'cart.title' | t }}</h1>
        <p class="cart-page-count font-mono" ref="count" aria-live="polite">
          {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}
        </p>
      </header>

      <div class="cart-page-items" ref="items">
        {% if cart.item_count == 0 %}
          <div class="cart-empty">
            <span class="cart-empty-icon" aria-hidden="true">
              {% render 'icon-bag', size: 34 %}
            </span>
            <p class="cart-empty-title font-mono">YOUR BAG IS EMPTY</p>
            <p class="cart-empty-text">Add a piece to start. Free EU shipping over €120.</p>
          </div>
        {% else %}
          {% for item in cart.items %}
            {% if item.item_components != blank %}
              {% render 'bundle-fusion-line-item', item: item %}
            {% else %}
              {% render 'cart-line-item', item: item %}
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <aside class="cart-page-overview" ref="overview" aria-labelledby="cart-overview-title-{{ section.id }}">
      <div class="cart-page-overview-panel">
        <div class="cart-page-overview-head">
          <p class="cart-page-eyebrow font-mono">/OVERVIEW</p>
          <h2 id="cart-overview-title-{{ section.id }}">Cart overview</h2>
        </div>

        <dl class="cart-page-totals">
          <div class="cart-page-row">
            <dt class="font-mono">PRICE</dt>
            <dd><cart-money value="{{ cart.original_total_price }}"></cart-money></dd>
          </div>

          {% if cart.total_discount > 0 %}
            <div class="cart-page-row cart-page-row-discount">
              <dt class="font-mono">DISCOUNT</dt>
              <dd>-<cart-money value="{{ cart.total_discount }}"></cart-money></dd>
            </div>
          {% endif %}

          <div class="cart-page-row cart-page-row-total">
            <dt class="font-mono">SUBTOTAL</dt>
            <dd><cart-money value="{{ cart.total_price }}"></cart-money></dd>
          </div>
        </dl>

        <p class="cart-page-note">Shipping, taxes and duties are calculated at checkout.</p>

        <form action="{{ routes.cart_url }}" method="post" class="cart-page-checkout-form">
          <button
            type="submit"
            name="checkout"
            class="cart-page-checkout button button-accent font-mono"
            {% if cart.item_count == 0 %}disabled{% endif %}
          >
            <span>CHECKOUT</span>
            {% render 'icon-arrow-right', size: 16 %}
          </button>
        </form>
      </div>
    </aside>
  </div>
</cart-page>

{% stylesheet %}
  cart-page {
    --cart-page-gap: 20px;
    --cart-page-item-image-size: 84px;
    --cart-page-sticky-top: calc(var(--header-height, 0px) + var(--spacing));
    --cart-page-dock-clearance: calc(var(--header-mobile-bar-height, 58px) + var(--header-mobile-menu-gap, 8px) + var(--spacing) + env(safe-area-inset-bottom, 0px));

    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: var(--spacing) calc(var(--cart-page-dock-clearance) + var(--spacing));

    .cart-page-layout {
      grid-column: 2;
      display: flex;
      flex-direction: column;
      gap: var(--cart-page-gap);
      min-width: 0;
    }

    .cart-page-main,
    .cart-page-overview {
      min-width: 0;
    }

    .cart-page-main {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .cart-page-header,
    .cart-page-overview-panel {
      border: 1px solid var(--border-color);
      background: var(--white);
    }

    .cart-page-header {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 18px 20px;
    }

    .cart-page-header h1,
    .cart-page-overview h2,
    .cart-page-eyebrow,
    .cart-page-count,
    .cart-page-note {
      margin: 0;
    }

    .cart-page-header h1 {
      font-size: 42px;
      line-height: 0.95;
    }

    .cart-page-eyebrow,
    .cart-page-count,
    .cart-page-row dt {
      font-size: 11px;
      text-transform: uppercase;
    }

    .cart-page-items {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 220px;
    }

    .cart-empty {
      display: grid;
      place-items: center;
      align-content: center;
      gap: 12px;
      min-height: 320px;
      border: 1px solid var(--border-color);
      background: var(--white);
      text-align: center;
      color: var(--secondary-black);
    }

    .cart-empty-title,
    .cart-empty-text {
      margin: 0;
    }

    .cart-empty-title {
      font-size: 11px;
    }

    .cart-empty-text {
      max-width: 260px;
      font-size: 14px;
    }

    cart-item {
      display: grid;
      grid-template-columns: var(--cart-page-item-image-size) minmax(0, 1fr);
      gap: 12px;
      position: relative;
      margin: 0;
      min-height: var(--cart-page-item-image-size);
      padding: 12px;
      border: 1px solid var(--border-color);
      background: var(--white);
    }

    cart-item[pending] {
      opacity: 0.45;
      pointer-events: none;
    }

    .cart-item-image {
      display: block;
      width: var(--cart-page-item-image-size);
      height: var(--cart-page-item-image-size);
      background: var(--background-darken);
      color: inherit;
    }

    .cart-item-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cart-item-info {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
      min-width: 0;
    }

    .cart-item-title {
      display: block;
      color: var(--black);
      overflow: hidden;
      text-decoration: none;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .cart-item-variant,
    .cart-item-properties {
      display: grid;
      gap: 2px;
      margin: 3px 0 0;
      font-size: 10px;
    }

    .cart-item-actions {
      display: inline-grid;
      grid-template-columns: 28px 36px 28px;
      align-items: center;
      width: max-content;
      border: 1px solid var(--border-color);
    }

    .cart-item-actions button {
      width: 28px;
      height: 24px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--black);
      cursor: pointer;
    }

    .cart-item-actions span {
      text-align: center;
      font-size: 12px;
    }

    .cart-item-meta {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-width: 0;
      padding-top: 12px;
      border-top: 1px solid var(--border-color);
    }

    .cart-item-price {
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
      font-family: var(--font-mono--family);
      font-size: 12px;
      white-space: nowrap;
    }

    .cart-item-price s {
      color: var(--red);
      font-size: 10px;
      text-decoration-thickness: 1px;
    }

    .cart-item-remove {
      display: flex;
      align-items: center;
      gap: 4px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--secondary-black);
      font-size: 10px;
      letter-spacing: 0.12em;
      cursor: pointer;
    }

    .cart-item-remove svg {
      flex: 0 0 auto;
    }

    .bundle-fusion-line-item .cart-item-info {
      justify-content: start;
    }

    .bundle-fusion-components {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 12px;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .bundle-fusion-component {
      display: block;
      flex: 0 0 auto;
      width: 32px;
      aspect-ratio: 251 / 376;
      border: 1px solid var(--border-color);
      background: var(--background-darken);
      color: inherit;
      overflow: hidden;
    }

    .bundle-fusion-component-main {
      border-color: var(--black);
    }

    .bundle-fusion-nested {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
    }

    .bundle-fusion-component img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .bundle-fusion-arrow {
      flex: 0 0 auto;
      color: var(--secondary-black);
      font-size: 10px;
      letter-spacing: 0.12em;
    }

    .cart-page-overview-panel {
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding: 18px 20px;
    }

    .cart-page-overview-head {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .cart-page-overview h2 {
      font-size: 22px;
      line-height: 1.1;
    }

    .cart-page-totals {
      display: flex;
      flex-direction: column;
      margin: 0;
      border-block: 1px solid var(--border-color);
    }

    .cart-page-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding-block: 13px;
      border-bottom: 1px solid var(--border-color);
    }

    .cart-page-row:last-child {
      border-bottom: 0;
    }

    .cart-page-row dd {
      display: flex;
      align-items: center;
      gap: 2px;
      margin: 0;
      font-family: var(--font-mono--family);
      font-size: 14px;
      white-space: nowrap;
    }

    .cart-page-row-discount dd {
      color: var(--red);
    }

    .cart-page-row-total dd {
      font-size: 20px;
      font-weight: 700;
    }

    .cart-page-note {
      color: var(--secondary-black);
      font-size: 13px;
      line-height: 1.4;
    }

    .cart-page-checkout-form {
      display: block;
      width: 100%;
    }

    .cart-page-checkout {
      width: 100%;
      min-height: 44px;
      cursor: pointer;
    }
  }

  @media screen and (min-width: 750px) {
    cart-page {
      --cart-page-item-image-size: 104px;
      padding-block: var(--spacing);

      .cart-page-header {
        min-height: 160px;
      }

      .cart-page-header h1 {
        font-size: 68px;
      }

      cart-item {
        grid-template-columns: var(--cart-page-item-image-size) minmax(0, 1fr) auto;
        min-height: calc(var(--cart-page-item-image-size) + 24px);
      }

      .cart-item-meta {
        grid-column: auto;
        flex-direction: column;
        align-items: flex-end;
        justify-content: space-between;
        min-width: max-content;
        padding-top: 0;
        border-top: 0;
      }
    }
  }

  @media screen and (min-width: 990px) {
    cart-page {
      .cart-page-layout {
        flex-direction: row;
        align-items: flex-start;
      }

      .cart-page-main {
        flex: 1 1 auto;
      }

      .cart-page-overview {
        flex: 0 0 min(380px, 34vw);
        position: sticky;
        top: var(--cart-page-sticky-top);
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
