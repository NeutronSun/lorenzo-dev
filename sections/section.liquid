{% render 'spacing', section: section %}

{% if section.settings.has_inner_dialog %}
  {% style %}
    #shopify-section-{{ section.id }}:has(dialog[open]) {
      position: relative;
      z-index: var(--z-index-drawer);
    }
  {% endstyle %}
{% endif %}

<div class="default-section section-{{ section.id }}">
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .default-section {
    background-color: var(--white);
    border: 1px solid var(--border-color);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Section",
  "class": "section page-width",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "default_spacing",
      "label": "Default spacing",
      "default": true
    },
    {
      "visible_if": "{{ section.settings.default_spacing == false }}",
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Spacing top mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "visible_if": "{{ section.settings.default_spacing == false }}",
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Spacing bottom mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "visible_if": "{{ section.settings.default_spacing == false }}",
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Spacing top desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "visible_if": "{{ section.settings.default_spacing == false }}",
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Spacing bottom desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Dialog"
    },
    {
      "type": "checkbox",
      "id": "has_inner_dialog",
      "label": "Has inner dialog",
      "info": "Raises this section above page content while a nested dialog is open.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Section"
    }
  ]
}
{% endschema %}
