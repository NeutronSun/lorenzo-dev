<h1>{{ collection.title }}</h1>


{% content_for 'block', type: 'filters', id: 'filters-and-sorting', source: collection %}

<product-grid>
  {% paginate collection.products by 18 %}
    {% for product in collection.products %}
      {% content_for 'block', type: 'product-card', id: 'product-card', product: product %}
    {% endfor %}

    {{ paginate | default_pagination }}
  {% endpaginate %}
</product-grid>

{% stylesheet %}

  product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(50px, 1fr));
    gap: 4px;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(5, minmax(200px, 1fr));
    }
  }
  
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "class": "section page-width",
  "settings": [


  ]
}
{% endschema %}
