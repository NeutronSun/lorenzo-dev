<h1>{{ collection.title }}</h1>


{% content_for 'block', type: 'filters', id: 'filters-and-sorting', source: collection %}

<product-grid class="">
  {% paginate collection.products by 18 %}
    {% capture products %}
      {% for product in collection.products %}
        {% content_for 'block', type: 'product-card', id: 'product-card', product: product %}
      {% endfor %}
    {% endcapture %}

    {{ products }}

    {{ paginate | default_pagination }}
  {% endpaginate %}
</product-grid>

{% stylesheet %}

  product-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(200px, 1fr));
    gap: 4px;
  }
  
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "class": "section page-width",
  "settings": [


  ]
}
{% endschema %}
