<sticky-header>
  <header ref="header">
    <div class="header-left header-group">

      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="header-link">
          {{ link.title }}
        </a>
      {% endfor %}

    </div>
    <div class="header-center">
      <a href="{{ routes.root_url }}">
        <img src="{{ settings.logo | image_url: width: 100 }}" alt="{{ shop.name }}" width="100" height="100">
      </a>
    </div>
    <div class="header-right header-group">
    </div>
  </header>
</sticky-header>

{% stylesheet %}
  .uyn-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: transparent;

    sticky-header {
      margin-top: var(--header-spacing-top);
      padding: 5px;
      border-radius: .4px;
      background-color: var(--black);

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        .header-link {
          text-decoration: none;
          color: var(--white);
        }

        .header-group:has(.header-link:hover) {
          .header-link {
            color: oklch(from var(--white) var(--disabled-l) var(--disabled-c) h);

            &:hover {
              color: var(--white);
            }
          }
        }
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UYN Header",
  "class": "uyn-header section page-width",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ],
  "presets": [
    {
      "name": "UYN Header"
    }
  ]
}
{% endschema %}
