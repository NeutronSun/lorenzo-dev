{% liquid
  assign color_tokens = 'red,yellow,green,blue,purple,pink,orange,gray,black,white' | split: ','
  assign hue_steps = '0,45,90,135,180,225,270,315,360' | split: ','
  assign drawer_id = section.id
  assign drawer_directions = 'left,right,top,bottom' | split: ','
%}

{% comment %} Drawers — height auto {% endcomment %}
{% for direction in drawer_directions %}
  <dialog-component name="style-guide-{{ direction }}-auto-{{ drawer_id }}">
    <dialog ref="dialog" class="drawer from-{{ direction }}">
      <div class="style-guide__drawer">
        <h2 class="font-heading">From {{ direction }}</h2>
        <p class="font-body"><code>drawer from-{{ direction }}</code></p>
        <p class="font-body style-guide__drawer-note">Height auto.{% if direction == 'top' or direction == 'bottom' %} Full width.{% else %} Side spacing on left/right.{% endif %}</p>
        <form method="dialog">
          <button class="button button-secondary" type="submit">Close</button>
        </form>
      </div>
    </dialog>
  </dialog-component>
{% endfor %}

{% comment %} Drawers — full height {% endcomment %}
{% for direction in drawer_directions %}
  <dialog-component name="style-guide-{{ direction }}-full-{{ drawer_id }}">
    <dialog ref="dialog" class="drawer from-{{ direction }} full-height">
      <div class="style-guide__drawer style-guide__drawer--full-height">
        <h2 class="font-heading">From {{ direction }}</h2>
        <p class="font-body"><code>drawer from-{{ direction }} full-height</code></p>
        <p class="font-body style-guide__drawer-note">Full viewport height.{% if direction == 'top' or direction == 'bottom' %} Full width.{% else %} Side spacing on left/right.{% endif %}</p>
        <form method="dialog">
          <button class="button button-secondary" type="submit">Close</button>
        </form>
      </div>
    </dialog>
  </dialog-component>
{% endfor %}

<div class="section">
  <div class="page-width style-guide">
    <header class="style-guide__intro">
      <p class="style-guide__eyebrow font-body">Theme reference</p>
      <h1 class="style-guide__title font-heading">Style Guide</h1>
      <p class="style-guide__lead font-body">
        Tokens, utilities and components available in this theme.
      </p>
    </header>

    <section class="style-guide__block" aria-labelledby="colors-heading">
      <div class="style-guide__block-header">
        <h2 id="colors-heading" class="font-heading">Colors</h2>
        <p class="font-body">
          Utility class <code>.color-*</code> sets <code>--color</code>. States are derived with
          <code>oklch(from var(--color) …)</code> — relative color syntax that reads
          the base color and outputs a new one.
        </p>
      </div>

      <div class="style-guide__oklch-note font-body">
        <p><strong>OKLCH</strong> = Lightness · Chroma · Hue</p>
        <ul class="style-guide__token-list">
          <li><code>L</code> (lightness) — hover darkens by lowering <code>L</code>. Disabled sets a fixed <code>L</code>.</li>
          <li><code>C</code> (chroma) — color intensity. Disabled lowers it for a washed-out look.</li>
          <li><code>H</code> (hue) — the color angle. Kept on every state so the family stays recognizable.</li>
        </ul>
      </div>

      <ul class="style-guide__swatches">
        {% for token in color_tokens %}
          <li class="style-guide__swatch color-{{ token }}">
            <div class="style-guide__swatch-meta font-body">
              <strong>.color-{{ token }}</strong>
              <code>--{{ token }}</code> → <code>--color</code>
            </div>

            <ul class="style-guide__state-scale">
              <li class="style-guide__scale-item">
                <span class="style-guide__scale-step style-guide__scale-step--default" aria-hidden="true"></span>
                <span class="style-guide__scale-label font-body">Default</span>
              </li>
              <li class="style-guide__scale-item">
                <span class="style-guide__scale-step style-guide__scale-step--hover" aria-hidden="true"></span>
                <span class="style-guide__scale-label font-body">Hover</span>
              </li>
              <li class="style-guide__scale-item">
                <span class="style-guide__scale-step style-guide__scale-step--disabled" aria-hidden="true"></span>
                <span class="style-guide__scale-label font-body">Disabled</span>
              </li>
            </ul>

            <ul class="style-guide__tone-scale">
              <li class="style-guide__scale-item">
                <span class="style-guide__scale-step style-guide__scale-step--light" aria-hidden="true"></span>
                <span class="style-guide__scale-label font-body">Light</span>
              </li>
              <li class="style-guide__scale-item">
                <span class="style-guide__scale-step style-guide__scale-step--soft" aria-hidden="true"></span>
                <span class="style-guide__scale-label font-body">Soft</span>
              </li>
              <li class="style-guide__scale-item">
                <span class="style-guide__scale-step style-guide__scale-step--base" aria-hidden="true"></span>
                <span class="style-guide__scale-label font-body">Base</span>
              </li>
              <li class="style-guide__scale-item">
                <span class="style-guide__scale-step style-guide__scale-step--strong" aria-hidden="true"></span>
                <span class="style-guide__scale-label font-body">Strong</span>
              </li>
              <li class="style-guide__scale-item">
                <span class="style-guide__scale-step style-guide__scale-step--dark" aria-hidden="true"></span>
                <span class="style-guide__scale-label font-body">Dark</span>
              </li>
            </ul>

            <ul class="style-guide__hue-scale">
              {% for hue_step in hue_steps %}
                <li class="style-guide__scale-item">
                  <span class="style-guide__scale-step style-guide__hue-step style-guide__hue-step--{{ hue_step }}" aria-hidden="true"></span>
                  <span class="style-guide__scale-label font-body">+{{ hue_step }}°</span>
                </li>
              {% endfor %}
            </ul>

            <ul class="style-guide__token-list style-guide__swatch-formulas font-body">
              <li><strong>Hover</strong> <code>l - var(--hover-l)</code></li>
              <li><strong>Disabled</strong> <code>var(--disabled-l)</code> / <code>var(--disabled-c)</code></li>
              <li><strong>Hue</strong> <code>calc(h + 45)</code> … <code>calc(h + 360)</code></li>
            </ul>
          </li>
        {% endfor %}
      </ul>

      <details class="style-guide__formula font-body">
        <summary>CSS formulas</summary>
        <ul class="style-guide__token-list">
          <li><strong>Default</strong> — <code>background: var(--color)</code></li>
          <li><strong>Hover</strong> — <code>oklch(from var(--color) calc(l - var(--hover-l)) c h)</code></li>
          <li><strong>Disabled</strong> — <code>oklch(from var(--color) var(--disabled-l) var(--disabled-c) h)</code></li>
          <li><strong>Tones</strong> — adjust <code>l</code> and <code>c</code>, keep <code>h</code></li>
          <li><strong>Hue wheel</strong> — <code>oklch(from var(--color) l c calc(h + 45))</code></li>
        </ul>
      </details>
    </section>

    <section class="style-guide__block" aria-labelledby="typography-heading">
      <div class="style-guide__block-header">
        <h2 id="typography-heading" class="font-heading">Typography</h2>
        <p class="font-body">Font families from theme settings.</p>
      </div>

      <div class="style-guide__type-samples">
        <article class="style-guide__type-card">
          <p class="style-guide__type-label font-body"><code>.font-heading</code></p>
          <p class="font-heading style-guide__type-preview">The quick brown fox jumps over the lazy dog</p>
        </article>
        <article class="style-guide__type-card">
          <p class="style-guide__type-label font-body"><code>.font-body</code></p>
          <p class="font-body style-guide__type-preview">The quick brown fox jumps over the lazy dog</p>
        </article>
      </div>

      <ul class="style-guide__token-list font-body">
        <li><code>--font-heading--family</code></li>
        <li><code>--font-body--family</code></li>
        <li><code>--color-background</code></li>
        <li><code>--color-foreground</code></li>
      </ul>
    </section>

    <section class="style-guide__block" aria-labelledby="buttons-heading">
      <div class="style-guide__block-header">
        <h2 id="buttons-heading" class="font-heading">Buttons</h2>
        <p class="font-body">Base class <code>.button</code> with variants and color utilities.</p>
      </div>

      <div class="style-guide__button-row">
        <button class="button button-primary" type="button">.button-primary</button>
        <button class="button button-secondary" type="button">.button-secondary</button>
        <button class="button button-primary" type="button" disabled>.button:disabled</button>
      </div>

      <ul class="style-guide__button-grid">
        {% for token in color_tokens %}
          <li>
            <button class="button color-{{ token }}" type="button">.button.color-{{ token }}</button>
          </li>
        {% endfor %}
      </ul>
    </section>

    <section class="style-guide__block" aria-labelledby="layout-heading">
      <div class="style-guide__block-header">
        <h2 id="layout-heading" class="font-heading">Layout</h2>
        <p class="font-body">Page structure utilities.</p>
      </div>

      <ul class="style-guide__token-list font-body">
        <li><code>.section</code> — grid container</li>
        <li><code>.page-width</code> — centered content column</li>
        <li><code>.page-full</code> — full-bleed within a section</li>
        <li><code>--page-width</code> — max content width (theme setting)</li>
        <li><code>--page-margin</code> — side spacing (theme setting)</li>
      </ul>
    </section>

    <section class="style-guide__block" aria-labelledby="drawers-heading">
      <div class="style-guide__block-header">
        <h2 id="drawers-heading" class="font-heading">Drawers</h2>
        <p class="font-body">
          <code>dialog.drawer</code> + direction modifier. Add <code>full-height</code> for viewport height.
          <code>from-top</code> and <code>from-bottom</code> are always full width.
        </p>
      </div>

      <ul class="style-guide__token-list font-body">
        <li><code>--drawer-spacing</code> — default <code>20px</code></li>
        <li><code>--drawer-top-spacing</code> · <code>--drawer-right-spacing</code> · <code>--drawer-bottom-spacing</code> · <code>--drawer-left-spacing</code></li>
        <li><code>.full-height</code> — <code>height: 100dvh</code>, top/bottom spacing <code>0</code></li>
      </ul>

      <ul class="style-guide__drawer-meta font-body">
        <li><strong>.from-left</strong> / <strong>.from-right</strong> — side spacing, <code>33%</code> width from 750px</li>
        <li><strong>.from-top</strong> / <strong>.from-bottom</strong> — full width, vertical spacing on entry edge</li>
        <li>Without <code>full-height</code> — height follows content</li>
        <li>With <code>full-height</code> — panel fills viewport height</li>
      </ul>

      <div class="style-guide__drawer-groups">
        <div class="style-guide__drawer-group">
          <h3 class="font-heading">Height auto</h3>
          <ul class="style-guide__drawer-grid">
            {% for direction in drawer_directions %}
              <li>
                <dialog-opener name="style-guide-{{ direction }}-auto-{{ drawer_id }}">
                  <button class="button button-primary" type="button" on:click="publish">.from-{{ direction }}</button>
                </dialog-opener>
              </li>
            {% endfor %}
          </ul>
        </div>

        <div class="style-guide__drawer-group">
          <h3 class="font-heading">Full height</h3>
          <ul class="style-guide__drawer-grid">
            {% for direction in drawer_directions %}
              <li>
                <dialog-opener name="style-guide-{{ direction }}-full-{{ drawer_id }}">
                  <button class="button button-secondary" type="button" on:click="publish">.from-{{ direction }}.full-height</button>
                </dialog-opener>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>
  </div>
</div>

{% stylesheet %}
  .style-guide {
    display: grid;
    gap: 3rem;
    padding-block: 3rem 4rem;
  }

  .style-guide__intro {
    display: grid;
    gap: 0.75rem;
  }

  .style-guide__eyebrow {
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray);
  }

  .style-guide__title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .style-guide__lead {
    max-width: 60ch;
    line-height: 1.5;
    color: var(--gray);
  }

  .style-guide__block {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-block-start: 1px solid oklch(from var(--black) l c h / 0.1);
  }

  .style-guide__block-header {
    display: grid;
    gap: 0.5rem;
  }

  .style-guide__block-header h2 {
    font-size: 1.5rem;
  }

  .style-guide__block-header p,
  .style-guide__token-list {
    color: var(--gray);
    line-height: 1.5;
  }

  .style-guide__block-header code,
  .style-guide__token-list code,
  .style-guide__swatch-meta code,
  .style-guide__type-label code,
  .style-guide__oklch-note code,
  .style-guide__formula code {
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: oklch(from var(--black) l c h / 0.06);
  }

  .style-guide__oklch-note {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    background: oklch(from var(--black) l c h / 0.03);
    line-height: 1.5;
    color: var(--gray);
  }

  .style-guide__oklch-note strong {
    color: var(--black);
  }

  .style-guide__formula {
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    border: 1px solid oklch(from var(--black) l c h / 0.08);
    line-height: 1.6;
    color: var(--gray);
  }

  .style-guide__formula summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--black);
  }

  .style-guide__formula .style-guide__token-list {
    margin-top: 0.75rem;
  }

  .style-guide__swatches {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .style-guide__swatch {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid oklch(from var(--black) l c h / 0.08);
    background: oklch(from var(--black) l c h / 0.02);
  }

  .style-guide__swatch-meta {
    display: grid;
    gap: 0.25rem;
    font-size: 0.875rem;
  }

  .style-guide__state-scale,
  .style-guide__tone-scale,
  .style-guide__hue-scale {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .style-guide__state-scale {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .style-guide__tone-scale {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .style-guide__hue-scale {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .style-guide__scale-item {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .style-guide__scale-step {
    min-height: 2.75rem;
    border-radius: 0.375rem;
    border: 1px solid oklch(from var(--black) l c h / 0.08);
  }

  .style-guide__scale-step--default {
    background: var(--color);
  }

  .style-guide__scale-step--hover {
    background: oklch(from var(--color) calc(l - var(--hover-l)) c h);
  }

  .style-guide__scale-step--disabled {
    background: oklch(from var(--color) var(--disabled-l) var(--disabled-c) h);
  }

  .style-guide__scale-step--light {
    background: oklch(from var(--color) 92% calc(c * 0.35) h);
  }

  .style-guide__scale-step--soft {
    background: oklch(from var(--color) 78% calc(c * 0.6) h);
  }

  .style-guide__scale-step--base {
    background: var(--color);
  }

  .style-guide__scale-step--strong {
    background: oklch(from var(--color) calc(l - 10%) c h);
  }

  .style-guide__scale-step--dark {
    background: oklch(from var(--color) 34% c h);
  }

  .style-guide__hue-step--0 {
    background: oklch(from var(--color) l c h);
  }

  .style-guide__hue-step--45 {
    background: oklch(from var(--color) l c calc(h + 45));
  }

  .style-guide__hue-step--90 {
    background: oklch(from var(--color) l c calc(h + 90));
  }

  .style-guide__hue-step--135 {
    background: oklch(from var(--color) l c calc(h + 135));
  }

  .style-guide__hue-step--180 {
    background: oklch(from var(--color) l c calc(h + 180));
  }

  .style-guide__hue-step--225 {
    background: oklch(from var(--color) l c calc(h + 225));
  }

  .style-guide__hue-step--270 {
    background: oklch(from var(--color) l c calc(h + 270));
  }

  .style-guide__hue-step--315 {
    background: oklch(from var(--color) l c calc(h + 315));
  }

  .style-guide__hue-step--360 {
    background: oklch(from var(--color) l c calc(h + 360));
  }

  .style-guide__scale-label {
    font-size: 0.6875rem;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--gray);
  }

  .style-guide__scale-detail {
    font-size: 0.625rem;
    text-align: center;
    line-height: 1.4;
    color: var(--gray);
  }

  .style-guide__scale-detail code {
    font-size: 1em;
    padding: 0;
    background: none;
    word-break: break-word;
  }

  .style-guide__scale-detail span {
    letter-spacing: 0.02em;
  }

  .style-guide__swatch-formulas {
    font-size: 0.75rem;
  }

  .style-guide__type-samples {
    display: grid;
    gap: 1rem;
  }

  .style-guide__type-card {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border-radius: 0.5rem;
    background: oklch(from var(--black) l c h / 0.03);
  }

  .style-guide__type-preview {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.3;
  }

  .style-guide__token-list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .style-guide__button-row,
  .style-guide__drawer-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .style-guide__button-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .style-guide__drawer {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-height: 12rem;
    padding: 1.5rem;
    background: var(--white);
    color: var(--black);
  }

  .style-guide__drawer--full-height {
    min-height: 100%;
  }

  .style-guide__drawer-note {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--gray);
  }

  .style-guide__drawer-groups {
    display: grid;
    gap: 1.5rem;
  }

  .style-guide__drawer-group {
    display: grid;
    gap: 0.75rem;
  }

  .style-guide__drawer-group h3 {
    font-size: 1rem;
  }

  .style-guide__drawer-meta {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 1rem 1.25rem;
    margin: 0;
    border-radius: 0.5rem;
    background: oklch(from var(--black) l c h / 0.03);
    line-height: 1.5;
    color: var(--gray);
  }

  @media (min-width: 750px) {
    .style-guide__drawer-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 750px) {
    .style-guide__swatches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .style-guide__type-samples {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .style-guide__button-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .style-guide__swatches {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .style-guide__button-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Style Guide",
  "settings": [],
  "presets": [
    {
      "name": "Style Guide",
      "category": "Demo"
    }
  ]
}
{% endschema %}
