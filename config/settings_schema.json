[
  {
    "name": "theme_info",
    "theme_name": "Sunyx Tech Dev Theme",
    "theme_version": "0.8.5",
    "theme_author": "NeutronSun",
    "theme_documentation_url": "https://github.com/neutronSun/lorenzo-dev",
    "theme_support_url": "https://github.com/neutronSun/lorenzo-dev/issues"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n4",
        "label": "Heading"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "Body"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "120rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "140rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "120rem"
      },
      {
        "type": "range",
        "id": "min_page_margin_mobile",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Page margin mobile",
        "default": 20
      },
      {
        "type": "range",
        "id": "min_page_margin_desktop",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Page margin desktop",
        "default": 40
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Logos",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Storefront API",
    "settings": [
      {
        "type": "text",
        "id": "storefront_access_token",
        "label": "Storefront access token"
      },
      {
        "type": "text",
        "id": "storefront_api_version",
        "label": "Storefront API version",
        "default": "2026-04"
      }
    ]
  }
]
